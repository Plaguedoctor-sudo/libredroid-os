# SPDX-License-Identifier: GPL-3.0-or-later
# AppArmor Profile for LibreDroid Local Unbound DoT Resolver
# Spec compliance: LibreDroid System Design v0.1 §8.c, §14 (Resolver & MAC)

#include <tunables/global>

/usr/sbin/unbound flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/ssl_certs>

  capability net_bind_service,
  capability setuid,
  capability setgid,

  # Network access: loopback listener and upstream DoT port 853
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,

  # Configuration and trust anchors
  /etc/unbound/** r,
  /etc/ssl/** r,
  /var/lib/unbound/** rw,
  /run/unbound/** rw,

  # Deny all access to arbitrary user files and containers
  deny /home/** mrwklx,
  deny /var/lib/waydroid/** mrwklx,
}
