<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- SPDX-License-Identifier: Apache-2.0 OR GPL-3.0-or-later -->
<node>
  <interface name="org.freestack.Keystore">
    <method name="GenerateKey">
      <arg name="alias" type="s" direction="in"/>
      <arg name="algorithm" type="i" direction="in"/>
      <arg name="purpose" type="u" direction="in"/>
      <arg name="hardware_backed" type="b" direction="in"/>
      <arg name="status" type="i" direction="out"/>
    </method>
    <method name="DeleteKey">
      <arg name="alias" type="s" direction="in"/>
      <arg name="status" type="i" direction="out"/>
    </method>
    <method name="Sign">
      <arg name="alias" type="s" direction="in"/>
      <arg name="digest" type="ay" direction="in"/>
      <arg name="status" type="i" direction="out"/>
      <arg name="signature" type="ay" direction="out"/>
    </method>
    <method name="Verify">
      <arg name="alias" type="s" direction="in"/>
      <arg name="digest" type="ay" direction="in"/>
      <arg name="signature" type="ay" direction="in"/>
      <arg name="verified" type="b" direction="out"/>
    </method>
    <method name="Encrypt">
      <arg name="alias" type="s" direction="in"/>
      <arg name="plaintext" type="ay" direction="in"/>
      <arg name="status" type="i" direction="out"/>
      <arg name="ciphertext" type="ay" direction="out"/>
    </method>
    <method name="Decrypt">
      <arg name="alias" type="s" direction="in"/>
      <arg name="ciphertext" type="ay" direction="in"/>
      <arg name="status" type="i" direction="out"/>
      <arg name="plaintext" type="ay" direction="out"/>
    </method>
    <method name="Attest">
      <arg name="alias" type="s" direction="in"/>
      <arg name="nonce" type="ay" direction="in"/>
      <arg name="status" type="i" direction="out"/>
      <arg name="pcr_digest" type="ay" direction="out"/>
      <arg name="attest_sig" type="ay" direction="out"/>
    </method>
    <signal name="KeyRotated">
      <arg name="alias" type="s"/>
      <arg name="timestamp" type="t"/>
    </signal>
  </interface>
</node>
