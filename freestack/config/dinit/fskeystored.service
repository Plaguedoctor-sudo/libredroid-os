# FreeStack Dinit Service: Sovereign Keystore Daemon (Task 5.9)
type = process
command = /usr/bin/bwrap --unshare-all --die-with-parent --ro-bind / / --dev /dev --proc /proc --tmpfs /run --tmpfs /tmp /usr/libexec/fskeystored
smooth-recovery = true
restart = true
depends-on = boot
