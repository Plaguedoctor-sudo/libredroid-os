# SPDX-License-Identifier: GPL-3.0-or-later
# FreeStack Linux Kernel Hardening Fragment: x86_64 ThinkPad X200 (Task 4.5)
# Aligned with Kernel Self Protection Project (KSPP) & non-negotiables R1–R12.

# Security Framework & LSMs
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=n
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y
CONFIG_LSM="landlock,lockdown,yama,selinux,bpf"

# Syscall Sandboxing & Namespaces
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y

# Memory & Address Space Hardening
CONFIG_PAGE_TABLE_ISOLATION=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_PAGE_POISONING=y

# Stack & Control Flow Protection
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_REFCOUNT_FULL=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_RETPOLINE=y

# Attack Surface Reduction & Attack Vector Elimination
CONFIG_DEVMEM=n
CONFIG_DEVPORT=n
CONFIG_COMPAT_BRK=n
CONFIG_BINFMT_MISC=n
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_ACPI_CUSTOM_METHOD=n
CONFIG_KEXEC=n
CONFIG_HIBERNATION=n
CONFIG_USERFAULTFD=n
