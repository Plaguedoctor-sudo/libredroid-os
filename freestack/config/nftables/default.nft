#!/usr/sbin/nft -f
# SPDX-License-Identifier: GPL-3.0-or-later
# Default-deny egress. Nothing leaves without a named rule.

table inet fs {
  set dns_servers   { type ipv4_addr; }
  set nts_servers   { type ipv4_addr; }
  set update_hosts  { type ipv4_addr; }
  set blocklist     { type ipv4_addr; }

  chain input {
    type filter hook input priority 0; policy drop;
    iif lo accept
    ct state established,related accept
    ct state invalid drop
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
    ct state established,related accept
  }

  chain output {
    type filter hook output priority 0; policy drop;
    oif lo accept
    ct state established,related accept
    udp dport 53 ip daddr @dns_servers accept
    tcp dport 853 ip daddr @nts_servers accept
    udp dport 123 ip daddr @nts_servers accept
    tcp dport { 80, 443 } ip daddr @update_hosts accept
    ip daddr @blocklist drop
    # everything else: dropped, surfaced by opensnitch for a decision
  }
}
