#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
# Minimal Cap'n Proto CLI validator powered by pycapnp
import sys
import os
import glob
import capnp

if len(sys.argv) > 1 and sys.argv[1] == "compile":
    files = []
    imports = ["interface", "."]
    i = 2
    while i < len(sys.argv):
        arg = sys.argv[i]
        if arg.startswith("-I"):
            imports.append(arg[2:] if len(arg) > 2 else sys.argv[i+1])
            if len(arg) == 2:
                i += 1
        elif arg.startswith("-o"):
            pass
        elif not arg.startswith("-"):
            for f in glob.glob(arg):
                files.append(f)
        i += 1

    for f in sorted(files):
        if f.endswith(".capnp"):
            try:
                capnp.load(f, imports=imports)
            except Exception as e:
                sys.stderr.write(f"capnp error in {f}: {e}\n")
                sys.exit(1)
    print("schema ok")
    sys.exit(0)

sys.stderr.write(f"capnp: unrecognized command {' '.join(sys.argv[1:])}\n")
sys.exit(1)
