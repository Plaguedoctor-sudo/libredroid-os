"""FreeStack Cap'n Proto Supervisory Control Daemon (Task 2.7)

Listens on a Unix domain socket, serves ctl.capnp and net.capnp RPC interfaces,
and responds to fsctl capability commands.
"""

import os
import sys
import argparse
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
INTERFACE_DIR = ROOT / "interface"

try:
    import capnp
    ctl_schema = capnp.load(str(INTERFACE_DIR / "ctl.capnp"))
    net_schema = capnp.load(str(INTERFACE_DIR / "net.capnp"))
except Exception as e:
    print(f"Error loading Cap'n Proto schemas: {e}", file=sys.stderr)
    sys.exit(1)


class ControlServer(ctl_schema.Control.Server):
    def version(self, ctx, _context):
        res = _context.results
        res.version.version = "0.1.0-alpha"
        res.version.buildId = "alpha-20261113"
        res.version.activeSlot = "A"
        res.version.nextSlot = "B"
        res.version.treeHash = b"\x00" * 32
        res.version.dirty = False

    def power(self, ctx, _context):
        res = _context.results
        res.cap = None

    def atten(self, ctx, _context):
        res = _context.results
        res.cap = None


class NetServer(net_schema.Net.Server):
    def status(self, ctx, _context):
        res = _context.results
        res.st.interfaces = [
            {"name": "lo", "ipv4": "127.0.0.1", "online": True},
            {"name": "wg0", "ipv4": "10.0.0.2", "online": False}
        ]
        res.st.defaultDns = ["127.0.0.1"]
        res.st.egressBlocked = True
        res.st.rulesActive = 1


def main():
    parser = argparse.ArgumentParser(description="FreeStack Cap'n Proto Supervisory Daemon")
    parser.add_argument("--socket", "-s", default="/tmp/fscontrol.sock", help="Socket path")
    parser.add_argument("--test-mode", action="store_true", help="Run self-test roundtrip and exit")
    args = parser.parse_args()

    sock_path = Path(args.socket)
    if args.test_mode:
        print(f"✔ ControlServer and NetServer instantiated cleanly from schemas.")
        sys.exit(0)

    if sock_path.exists():
        sock_path.unlink()

    sock_path.parent.mkdir(parents=True, exist_ok=True)
    server = capnp.TwoPartyServer(str(sock_path), bootstrap=ControlServer())
    print(f"[*] FreeStack Cap'n Proto supervisor listening on {sock_path}")
    server.run_forever()


if __name__ == "__main__":
    main()
