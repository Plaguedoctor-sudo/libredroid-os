#: tools/fs-setup.py:25
msgid "Welcome to FreeStack OS — Sovereign & Verified"
msgstr "مرحبًا بكم في نظام FreeStack — سيادي وموثق"

#: tools/fs-setup.py:32
msgid "Offline-First Installation: No online account or telemetry required."
msgstr "تثبيت محلي بالكامل: لا يتطلب حسابًا عبر الإنترنت أو بيانات قياس عن بُعد."

#: tools/fs-setup.py:45
msgid "Choose Root Encryption Passphrase"
msgstr "اختر عبارة مرور التشفير الجذرية"

#: tools/fs-setup.py:58
msgid "Hardware Keystore Initialized (TPM2 PCR Sealed)"
msgstr "تمت تهيئة مخزن المفاتيح العتادي (مختوم بـ TPM2 PCR)"

#: tools/fs-permissions.py:40
msgid "Network Access Request: Allow egress connection?"
msgstr "طلب الوصول إلى الشبكة: هل تريد السماح بالاتصال الخارجي؟"

#: tools/fs-permissions.py:48
msgid "Deny (Default)"
msgstr "رفض (افتراضي)"

#: tools/fs-permissions.py:49
msgid "Grant Once"
msgstr "منح لمرة واحدة"

#: tools/fs-permissions.py:50
msgid "Grant Always"
msgstr "منح دائمًا"

#: tools/fs-permissions.py:65
msgid "Keystore Access Request: Application requests signing capability"
msgstr "طلب وصول لمخزن المفاتيح: يطلب التطبيق قدرة التوقيع"
