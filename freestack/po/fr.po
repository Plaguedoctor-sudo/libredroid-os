#: tools/fs-setup.py:25
msgid "Welcome to FreeStack OS — Sovereign & Verified"
msgstr "Bienvenue sur FreeStack OS — Souverain et Vérifié"

#: tools/fs-setup.py:32
msgid "Offline-First Installation: No online account or telemetry required."
msgstr "Installation hors-ligne : Aucun compte en ligne ni télémétrie requis."

#: tools/fs-setup.py:45
msgid "Choose Root Encryption Passphrase"
msgstr "Choisissez la phrase de passe de chiffrement racine"

#: tools/fs-setup.py:58
msgid "Hardware Keystore Initialized (TPM2 PCR Sealed)"
msgstr "Trousseau matériel initialisé (scellé par TPM2 PCR)"

#: tools/fs-permissions.py:40
msgid "Network Access Request: Allow egress connection?"
msgstr "Demande d'accès réseau : Autoriser la connexion sortante ?"

#: tools/fs-permissions.py:48
msgid "Deny (Default)"
msgstr "Refuser (Par défaut)"

#: tools/fs-permissions.py:49
msgid "Grant Once"
msgstr "Autoriser une fois"

#: tools/fs-permissions.py:50
msgid "Grant Always"
msgstr "Toujours autoriser"

#: tools/fs-permissions.py:65
msgid "Keystore Access Request: Application requests signing capability"
msgstr "Demande d'accès au trousseau : L'application demande la signature"

#: keystore/src/fskeystored.c:85
msgid "Hardware Attestation Statement Generated"
msgstr "Déclaration d'attestation matérielle générée"
