#!/usr/bin/env bash
# lrd-powerd — idle policy, thermal policy, battery thresholds. Publishes over the
# event bus so the shell reacts instead of polling.
set -uo pipefail
EMIT="${EMIT:-/usr/local/bin/lrd-emit}"
IDLE_DIM="${IDLE_DIM:-60}"      # seconds
IDLE_OFF="${IDLE_OFF:-180}"
IDLE_SUSPEND="${IDLE_SUSPEND:-600}"
CRIT="${CRIT:-5}"
say(){ printf '\033[1;36m::\033[0m %s\n' "$*"; logger -t lrd-powerd "$*"; }

last_input() {
  local newest=0
  for d in /dev/input/event*; do
    [ -e "$d" ] || continue
    local t; t="$(stat -c %Y "$d" 2>/dev/null || echo 0)"
    [ "$t" -gt "$newest" ] && newest="$t"
  done
  echo "$newest"
}

brightness_get() {
  local b; b="$(ls -d /sys/class/backlight/* 2>/dev/null | head -1)"
  [ -n "$b" ] && cat "$b/brightness" || echo 0
}
brightness_set() {
  local b; b="$(ls -d /sys/class/backlight/* 2>/dev/null | head -1)"
  [ -n "$b" ] && echo "$1" > "$b/brightness" 2>/dev/null || true
}
brightness_max() {
  local b; b="$(ls -d /sys/class/backlight/* 2>/dev/null | head -1)"
  [ -n "$b" ] && cat "$b/max_brightness" || echo 255
}

battery() {
  for d in /sys/class/power_supply/battery /sys/class/power_supply/Battery; do
    [ -e "$d/capacity" ] && { cat "$d/capacity"; return; }
  done
  echo 100
}
charging() {
  for d in /sys/class/power_supply/battery /sys/class/power_supply/Battery; do
    [ -e "$d/status" ] && { grep -qiE 'charging|full' "$d/status" && echo yes || echo no; return; }
  done
  echo no
}

hottest() {
  local m=0
  for z in /sys/class/thermal/thermal_zone*; do
    [ -e "$z/temp" ] || continue
    local t; t="$(cat "$z/temp" 2>/dev/null || echo 0)"
    [ "$t" -gt 1000 ] && t=$((t/1000))
    [ "$t" -gt "$m" ] && m="$t"
  done
  echo "$m"
}

apply_thermal() {
  local t; t="$(hottest)"
  local target
  if   [ "$t" -ge 75 ]; then target=performance; [ "$t" -ge 85 ] && target=balanced
  elif [ "$t" -le 45 ]; then target=saver
  else target=balanced; fi
  [ "$target" != "$(cat /run/lrd/thermal.mode 2>/dev/null)" ] && {
    echo "$target" > /run/lrd/thermal.mode
    say "thermal ${t}C -> $target"
    "$EMIT" thermal "{\"max\":$t,\"mode\":\"$target\"}" 2>/dev/null || true
  }
}

say "started (dim=${IDLE_DIM}s off=${IDLE_OFF}s suspend=${IDLE_SUSPEND}s)"
prev_br=""
while :; do
  sleep 5
  now="$(date +%s)"
  idle=$(( now - $(last_input) ))

  # idle ladder
  case "$idle" in
    $((IDLE_SUSPEND+0))|$((IDLE_SUSPEND+1))|$((IDLE_SUSPEND+2))|$((IDLE_SUSPEND+3))|$((IDLE_SUSPEND+4)))
      [ -f /run/lrd/awake ] && { rm -f /run/lrd/awake; say "idle ${idle}s -> suspend"; systemctl suspend 2>/dev/null || true; } ;;
    *)
      if [ "$idle" -gt "$IDLE_SUSPEND" ] && [ -f /run/lrd/awake ]; then
        rm -f /run/lrd/awake; say "idle ${idle}s -> suspend"; systemctl suspend 2>/dev/null || true
      fi ;;
  esac
  if [ "$idle" -lt 5 ]; then
    [ ! -f /run/lrd/awake ] && { touch /run/lrd/awake; brightness_set "$(brightness_max)"; say "awake"; }
  elif [ "$idle" -gt "$IDLE_OFF" ]; then
    brightness_set 1
  elif [ "$idle" -gt "$IDLE_DIM" ]; then
    brightness_set $(( $(brightness_max) / 3 ))
  fi

  # battery
  pct="$(battery)"; chg="$(charging)"
  if [ "$pct" -le "$CRIT" ] && [ "$chg" = no ]; then
    if [ ! -f /run/lrd/critical ]; then
      touch /run/lrd/critical
      say "battery critical ($pct%)"
      "$EMIT" power "{\"percent\":$pct,\"mode\":\"critical\"}" 2>/dev/null || true
      systemctl start lrd-snapshot.service 2>/dev/null || true
      # give the user 60s, then hibernate-ish
      ( sleep 60; systemctl poweroff 2>/dev/null || true ) &
    fi
  else
    rm -f /run/lrd/critical
  fi

  apply_thermal
  br="$(brightness_get)"
  [ "$br" != "$prev_br" ] && { prev_br="$br"; "$EMIT" display "{\"brightnessRaw\":$br}" 2>/dev/null || true; }
done
