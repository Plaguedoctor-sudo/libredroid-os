#!/bin/sh
set -e
useradd -m -s /bin/bash -G video,render,audio,netdev,input,tty,systemd-journal,adm live
passwd -d live
echo 'live ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/live

# Clean any deprecated pam_lastlog.so references precisely without touching comments or pam_lastlog2
sed -i '/^[[:space:]]*session[[:space:]].*pam_lastlog\.so/d' /etc/pam.d/login /etc/pam.d/common-session 2>/dev/null || true

# autologin on tty1 (debug console)
mkdir -p /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/autologin.conf <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin live --noclear %I $TERM
EOF

# autologin on serial console ttyS0 (debug console)
mkdir -p /etc/systemd/system/serial-getty@ttyS0.service.d
cat > /etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin live --noclear 115200 %I $TERM
EOF

# startup script for shell ensuring bridge is listening before Chromium launches
cat > /usr/local/bin/lrd-shell-start <<'EOF'
#!/bin/sh
set -eu
ok=0
for _ in $(seq 1 100); do
  if curl -fsS -m1 http://127.0.0.1:3001/ >/dev/null 2>&1; then ok=1; break; fi
  sleep 0.3
done
[ "$ok" = 1 ] || { echo "bridge never answered on 3001" >&2; exit 69; }
exec /usr/bin/cage -- /usr/bin/chromium --kiosk --no-first-run \
  --no-default-browser-check --disable-features=Translate \
  --app=http://127.0.0.1:3001
EOF
chmod 0755 /usr/local/bin/lrd-shell-start

# kiosk session on tty7 (separate from debug consoles tty1 and ttyS0)
cat > /etc/systemd/system/lrd-shell.service <<'EOF'
[Unit]
Description=LibreDroid shell
After=network.target graphical.target lrd-bridge.service
Requires=lrd-bridge.service

[Service]
User=live
PAMName=login
TTYPath=/dev/tty7
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/local/bin/lrd-shell-start
Restart=always

[Install]
WantedBy=graphical.target
EOF

systemctl enable lrd-shell.service
systemctl set-default graphical.target
systemctl disable systemd-timesyncd.service || true
apt-get clean
rm -rf /var/lib/apt/lists/*
