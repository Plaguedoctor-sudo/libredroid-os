#!/usr/bin/env bash
# lrd-update / lrd-ota — check, download, stage, apply, rollback, and confirm A/B OTA system updates.
# In A/B architecture, updates are staged to the INACTIVE slot and armed.
# A failed update is automatically reverted by the bootloader without userspace intervention.
set -Eeuo pipefail

STORE="${LRD_STORE:-/lrdstore}"
KEYRING="${LRD_KEYRING:-/usr/share/lrd/keys/update.gpg}"
VERITY_PUBKEY="${LRD_VERITY_KEY:-/etc/lrd/keys/verity.pub.pem}"
BC="${LRD_BOOTCOUNT_BIN:-$(command -v lrd-bootcount 2>/dev/null || echo "/usr/sbin/lrd-bootcount")}"

say(){ printf '\033[1;36m::\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die(){ printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

cur_slot() {
  local s=""
  if [ -r /proc/cmdline ]; then
    s="$(sed -n 's/.*androidboot.slot_suffix=_\?\([ab]\).*/\1/p' /proc/cmdline 2>/dev/null || true)"
    [ -z "$s" ] && s="$(sed -n 's/.*lrd.slot=\([ab]\).*/\1/p' /proc/cmdline 2>/dev/null || true)"
  fi
  if [ -z "$s" ]; then
    if [ -n "${LRD_SLOT:-}" ]; then
      s="${LRD_SLOT#_}"
    elif [ -f /run/lrd/slot ]; then
      s="$(cat /run/lrd/slot 2>/dev/null || echo a)"
    elif [ -f /var/lib/lrd/active_slot ]; then
      s="$(cat /var/lib/lrd/active_slot 2>/dev/null || echo a)"
    else
      s="a"
    fi
  fi
  echo "$s"
}

other_slot() { [ "$(cur_slot)" = "a" ] && echo "b" || echo "a"; }

need_root() {
  if [ "${LRD_PERMIT_NONROOT:-0}" = "1" ]; then
    return 0
  fi
  [ "$(id -u)" = 0 ] || die "run as root"
}

mount_store() {
  mkdir -p "$STORE"
  if [ -d "$STORE/updates" ] || [ "${LRD_PERMIT_NONROOT:-0}" = "1" ]; then
    return 0
  fi
  mountpoint -q "$STORE" && return 0
  mount /dev/disk/by-label/LRD-STORE "$STORE" 2>/dev/null || \
  mount /dev/disk/by-label/LRDSTORE "$STORE" 2>/dev/null || \
  mount -L LRD-STORE "$STORE" 2>/dev/null || \
  mount -L LRDSTORE "$STORE" 2>/dev/null || \
  warn "cannot mount LRD-STORE partition directly; proceeding with local directory"
}

current_version() {
  if [ -f /etc/os-release ]; then
    sed -n 's/^VERSION_ID="\(.*\)"/\1/p' /etc/os-release 2>/dev/null || echo "1.0.0"
  else
    echo "1.0.0"
  fi
}

cmd="${1:-status}"
shift || true

case "$cmd" in

check)
  mount_store
  mkdir -p "$STORE/updates"
  latest="$(ls -1 "$STORE"/updates/lrd-update_*.json 2>/dev/null | sort -V | tail -1 || true)"
  [ -n "$latest" ] || die "no update sets found in $STORE/updates"
  ver="$(basename "$latest" .json | sed 's/^lrd-update_//')"

  if [ -f "$KEYRING" ] && [ -f "$latest.asc" ]; then
    gpg --no-default-keyring --keyring "$KEYRING" --verify "$latest.asc" "$latest" 2>/dev/null \
      || die "manifest signature INVALID"
    say "GPG manifest signature OK"
  elif [ -f "$VERITY_PUBKEY" ] && [ -f "$latest.sig" ]; then
    openssl dgst -sha256 -verify "$VERITY_PUBKEY" -signature "$latest.sig" "$latest" 2>/dev/null \
      || die "OpenSSL manifest signature INVALID"
    say "OpenSSL manifest signature OK"
  else
    warn "no verification key found — signatures unverified"
  fi

  jq . "$latest"
  echo
  say "current version: $(current_version) — available OTA: $ver"
  ;;

download)
  mount_store
  mkdir -p "$STORE/updates"
  latest="$(ls -1 "$STORE"/updates/lrd-update_*.json 2>/dev/null | sort -V | tail -1 || true)"
  [ -n "$latest" ] || die "no update manifest in $STORE/updates"
  ver="$(basename "$latest" .json | sed 's/^lrd-update_//')"

  if [ -n "${LRD_UPDATE_URL:-}" ]; then
    say "fetching $ver from $LRD_UPDATE_URL"
    for f in "lrd-rootfs_${ver}.raw" "lrd-rootfs_${ver}.raw.sha256" "lrd-rootfs_${ver}.raw.asc" \
             "lrd-boot_${ver}.img" "lrd-boot_${ver}.img.sha256" "lrd-boot_${ver}.img.asc" \
             "lrd-update_${ver}.json" "lrd-update_${ver}.json.asc"; do
      [ -f "$STORE/updates/$f" ] && continue
      curl -fL --progress-bar "$LRD_UPDATE_URL/$f" -o "$STORE/updates/$f" 2>/dev/null || warn "missing $f"
    done
  fi

  say "verifying payload checksums"
  if [ -f "$STORE/updates/lrd-rootfs_${ver}.raw.sha256" ]; then
    ( cd "$STORE/updates" && sha256sum -c "lrd-rootfs_${ver}.raw.sha256" ) || die "rootfs hash mismatch"
  fi
  if [ -f "$STORE/updates/lrd-boot_${ver}.img.sha256" ]; then
    ( cd "$STORE/updates" && sha256sum -c "lrd-boot_${ver}.img.sha256" ) || die "boot image hash mismatch"
  fi

  echo "$ver" > "$STORE/updates/.staged-version"
  say "downloaded and checksum verified: $ver"
  ;;

stage)
  need_root
  mount_store
  ver="$(cat "$STORE/updates/.staged-version" 2>/dev/null || true)"
  [ -n "$ver" ] || die "no update package downloaded — run 'lrd-update download' first"
  slot="$(other_slot)"
  say "staging update $ver to inactive slot $slot (currently running slot: $(cur_slot))"

  # Stage rootfs and boot image
  if [ -f "$STORE/updates/lrd-rootfs_${ver}.raw" ]; then
    cp -f "$STORE/updates/lrd-rootfs_${ver}.raw" "$STORE/lrd-rootfs_${slot}.raw.new"
    mv -f "$STORE/lrd-rootfs_${slot}.raw.new" "$STORE/lrd-rootfs_${slot}.raw"
  fi
  if [ -f "$STORE/updates/lrd-boot_${ver}.img" ]; then
    cp -f "$STORE/updates/lrd-boot_${ver}.img" "$STORE/lrd-boot_${slot}.img"
  fi

  echo "$ver" > "$STORE/lrd-version_${slot}"

  # Verity metadata staging and anti-rollback verification
  mkdir -p "$STORE/verity"
  if [ -f "$STORE/updates/lrd-verity_${slot}.json" ]; then
    cp -f "$STORE/updates/lrd-verity_${slot}.json"* "$STORE/verity/" 2>/dev/null || true
  elif [ -f "$STORE/updates/lrd-verity.json" ]; then
    cp -f "$STORE/updates/lrd-verity.json"* "$STORE/verity/lrd-verity_${slot}.json" 2>/dev/null || true
  fi

  # Monotonic anti-rollback validation
  meta="$STORE/verity/lrd-verity_${slot}.json"
  if [ -f "$meta" ]; then
    say "verifying update crypto layout and anti-rollback counter"
    new_counter="$(jq -r '.monotonicCounter // 0' "$meta" 2>/dev/null || echo 0)"
    counter_store="${LRD_ROLLBACK_STORE:-/var/lib/lrd/rollback_counter}"
    if [ -f "$counter_store" ]; then
      cur_counter="$(cat "$counter_store" 2>/dev/null || echo 0)"
      if [ "$new_counter" -lt "$cur_counter" ]; then
        die "ANTI-ROLLBACK REJECT: new counter ($new_counter) < active counter ($cur_counter)"
      fi
    fi
  fi

  sync
  say "update $ver staged cleanly into slot $slot. Run 'lrd-update apply' to arm and reboot."
  ;;

apply)
  need_root
  slot="$(other_slot)"
  tries="${1:-3}"
  say "arming inactive slot $slot with $tries boot attempts"
  if [ -x "$BC" ]; then
    "$BC" --arm "$slot" "$tries"
  fi

  # Write pending record for user/UI confirmation
  VAR_LIB_DIR="${LRD_VAR_LIB_DIR:-/var/lib/lrd}"
  mkdir -p "$VAR_LIB_DIR" 2>/dev/null || true
  jq -nc --arg from "$(current_version)" \
         --arg to "$(cat "$STORE/lrd-version_${slot}" 2>/dev/null || echo "unknown")" \
         --arg slot "$slot" \
         --arg tries "$tries" \
         --arg at "$(date -Is 2>/dev/null || date -u)" \
         '{from:$from, to:$to, slot:$slot, tries:($tries|tonumber), at:$at, armed:true}' \
         > "$VAR_LIB_DIR/update.pending" 2>/dev/null || true

  sync
  say "slot $slot successfully armed."
  if [ "${LRD_NO_REBOOT:-0}" != "1" ]; then
    say "rebooting into slot $slot..."
    if command -v systemctl >/dev/null 2>&1; then
      systemctl reboot || true
    fi
  else
    say "(LRD_NO_REBOOT=1: skipping automatic reboot)"
  fi
  ;;

rollback)
  need_root
  slot="$(other_slot)"
  say "forcing rollback to slot $slot"
  if [ -x "$BC" ]; then
    "$BC" --arm "$slot" 1
  fi
  sync
  if [ "${LRD_NO_REBOOT:-0}" != "1" ]; then
    say "rebooting into slot $slot..."
    if command -v systemctl >/dev/null 2>&1; then
      systemctl reboot || true
    fi
  else
    say "(LRD_NO_REBOOT=1: skipping automatic reboot)"
  fi
  ;;

status)
  mount_store 2>/dev/null || true
  cur="$(cur_slot)"
  oth="$(other_slot)"
  cur_ver="$(current_version)"
  oth_ver="$(cat "$STORE/lrd-version_$oth" 2>/dev/null || echo 'none')"
  VAR_LIB_DIR="${LRD_VAR_LIB_DIR:-/var/lib/lrd}"
  has_pending=false
  [ -f "$VAR_LIB_DIR/update.pending" ] && has_pending=true

  if [ "${1:-}" = "--json" ]; then
    jq -nc --arg cur "$cur" --arg oth "$oth" --arg cur_ver "$cur_ver" \
           --arg oth_ver "$oth_ver" --argjson pending "$has_pending" \
           '{"current_slot":$cur, "other_slot":$oth, "version":$cur_ver, "staged_version":$oth_ver, "pending":$pending}'
  else
    echo "running slot: $cur (version: $cur_ver)"
    echo "other slot:   $oth (staged version: $oth_ver)"
    if [ -x "$BC" ]; then
      echo "--- bootloader control ---"
      "$BC" --status
    fi
    if [ "$has_pending" = true ]; then
      echo "--- pending update ---"
      jq . "$VAR_LIB_DIR/update.pending"
    fi
  fi
  ;;

confirm)
  VAR_LIB_DIR="${LRD_VAR_LIB_DIR:-/var/lib/lrd}"
  rm -f "$VAR_LIB_DIR/update.pending"
  if [ -x "$BC" ]; then
    "$BC" --mark-success "$(cur_slot)"
  fi
  say "confirmed successful boot on slot $(cur_slot)"
  ;;

*)
  echo "usage: lrd-update {check|download|stage|apply [tries]|rollback|status [--json]|confirm}"
  exit 2
  ;;
esac
