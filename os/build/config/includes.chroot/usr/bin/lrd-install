#!/usr/bin/env bash
# lrd-install — universal bare-metal installer for LibreDroid OS
# Supports UEFI (x86_64, aarch64), Legacy BIOS (MBR), A/B dm-verity, and single partition layouts.
set -Eeuo pipefail

VERSION="$(sed -n 's/^VERSION_ID="\(.*\)"/\1/p' /etc/os-release 2>/dev/null || true)"
VERSION="${VERSION:-1.0.0}"
SOURCE="${LRD_SOURCE:-/run/live/rootfs}"

say(){ printf '\033[1;36m::\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m!!\033[0m %s\n' "$*"; }
err(){ printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; }
die(){ err "$*"; exit 1; }
ask(){ local p="$1" d="$2" v; printf '%s [%s]: ' "$p" "$d"; read -r v; echo "${v:-$d}"; }
confirm(){ printf '%s [y/N] ' "$1"; local a; read -r a; [ "$a" = y ] || [ "$a" = Y ]; }

part(){
  local dev="$1" num="$2"
  if [[ "$dev" =~ [0-9]$ ]]; then
    echo "${dev}p${num}"
  else
    echo "${dev}${num}"
  fi
}

usage(){
  cat <<EOF
Usage: $(basename "$0") [options]

Universal Bare-Metal Installer for LibreDroid OS.

Options:
  --auto                 Automatic non-interactive installation
  --yes, -y              Bypass confirmation prompts
  --disk <path>          Target block device (e.g. /dev/nvme0n1, /dev/sda)
  --layout <single|ab>   Partition layout (default: single)
  --luks <0|1>           Enable LUKS2 encryption (default: 0)
  --hostname <name>      System hostname (default: libredroid)
  --username <user>      Admin username (default: lrd)
  --password <pass>      Passphrase for user / encryption
  --recovery <0|1>       Provision recovery partition (default: 1)
  --source <dir|squashfs> Path to rootfs source
  --help, -h             Show this help message
EOF
}

for arg in "$@"; do
  if [ "$arg" = "--help" ] || [ "$arg" = "-h" ]; then
    usage
    exit 0
  fi
done

# Ensure root
[ "$(id -u)" = 0 ] || die "run as root"

AUTO=0
FORCE_YES=0
OPT_DISK=""
OPT_HOST=""
OPT_USER=""
OPT_LUKS=""
OPT_LAYOUT=""
OPT_RECOVERY=""
OPT_PASS=""

while [ $# -gt 0 ]; do
  case "$1" in
    --auto) AUTO=1; shift ;;
    --yes|-y) FORCE_YES=1; shift ;;
    --disk) OPT_DISK="$2"; shift 2 ;;
    --hostname) OPT_HOST="$2"; shift 2 ;;
    --username) OPT_USER="$2"; shift 2 ;;
    --luks) OPT_LUKS="$2"; shift 2 ;;
    --layout) OPT_LAYOUT="$2"; shift 2 ;;
    --recovery) OPT_RECOVERY="$2"; shift 2 ;;
    --source) SOURCE="$2"; shift 2 ;;
    --password|--pass) OPT_PASS="$2"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) shift ;;
  esac
done

# ---------- 1. disk discovery & selection ----------
mapfile -t DISKS < <(lsblk -dpno NAME,SIZE,TYPE,MODEL 2>/dev/null | awk '$3=="disk"{printf "%s %s %s\n",$1,$2,substr($0,index($0,$3)+length($3)+1)}')
[ "${#DISKS[@]}" -gt 0 ] || die "no storage disks found"

DISK=""
if [ -n "$OPT_DISK" ]; then
  [ -b "$OPT_DISK" ] || die "specified disk '$OPT_DISK' is not a valid block device"
  DISK="$OPT_DISK"
elif [ "$AUTO" = 1 ]; then
  # Auto-select the first disk >= 12GB
  for d in "${DISKS[@]}"; do
    cand="$(echo "$d" | awk '{print $1}')"
    if [ -b "$cand" ]; then
      sz_bytes=$(blockdev --getsize64 "$cand" 2>/dev/null || echo 0)
      if [ "$sz_bytes" -ge 12000000000 ]; then
        DISK="$cand"
        break
      fi
    fi
  done
  [ -n "$DISK" ] || DISK="$(echo "${DISKS[0]}" | awk '{print $1}')"
else
  echo "Available storage disks:"
  for i in "${!DISKS[@]}"; do printf '  %2d) %s\n' "$i" "${DISKS[$i]}"; done
  idx="$(ask "select disk number" 0)"
  DISK="$(echo "${DISKS[$idx]}" | awk '{print $1}')"
fi

[ -b "$DISK" ] || die "invalid target disk: $DISK"
SZ_GB=$(( $(blockdev --getsize64 "$DISK" 2>/dev/null || echo 0) / 1000 / 1000 / 1000 ))
[ "$SZ_GB" -ge 12 ] || die "$DISK is ${SZ_GB}G — need at least 12G for bare-metal install"

# ---------- 2. options & confirmation ----------
if [ "$AUTO" = 1 ]; then
  HOST="${OPT_HOST:-libredroid}"
  USERNAME="${OPT_USER:-lrd}"
  LUKS="${OPT_LUKS:-0}"
  RECOVERY="${OPT_RECOVERY:-1}"
  LAYOUT="${OPT_LAYOUT:-single}"
else
  HOST="${OPT_HOST:-$(ask hostname libredroid)}"
  USERNAME="${OPT_USER:-$(ask username lrd)}"
  if [ -n "$OPT_LUKS" ]; then
    LUKS="$OPT_LUKS"
  else
    LUKS=0; confirm "encrypt the disk (LUKS2)?" && LUKS=1
  fi
  if [ -n "$OPT_RECOVERY" ]; then
    RECOVERY="$OPT_RECOVERY"
  else
    RECOVERY=1; confirm "add a recovery partition?" || RECOVERY=0
  fi
  LAYOUT="${OPT_LAYOUT:-$(ask "layout (a/b slots|single)" single)}"
fi

cat <<EOF

  Target Disk: $DISK (${SZ_GB}G) — EVERYTHING ON THIS DISK WILL BE ERASED
  Hostname:    $HOST
  Username:    $USERNAME
  LUKS2 Crypt: $([ "$LUKS" = 1 ] && echo "yes (Argon2id)" || echo "no")
  Recovery:    $([ "$RECOVERY" = 1 ] && echo "yes" || echo "no")
  Layout:      $LAYOUT
  Firmware:    $([ -d /sys/firmware/efi ] && echo "UEFI" || echo "Legacy BIOS")
  Arch:        $(uname -m)

EOF

if [ "$FORCE_YES" != 1 ]; then
  confirm "proceed with bare-metal installation?" || die "installation aborted by user"
fi

# ---------- 3. partition table creation ----------
say "writing clean GPT partition table with hybrid UEFI + BIOS boot support"
wipefs -a "$DISK" >/dev/null 2>&1 || true
sgdisk -Z "$DISK" >/dev/null 2>&1

# Always add partition 9: 2MB BIOS Boot Partition (ef02) at sector 2048 for Legacy BIOS GRUB core image
sgdisk -n 9:2048:+2M -t 9:ef02 -c 9:BIOS-BOOT "$DISK" >/dev/null

if [ "$LAYOUT" = "a/b slots" ] || [ "$LAYOUT" = "ab" ]; then
  DATA_PARTNUM=8
  sgdisk -n 1:0:+512M   -t 1:ef00 -c 1:LRD-EFI     "$DISK" >/dev/null
  sgdisk -n 2:0:+256M   -t 2:8300 -c 2:LRD-BOOT    "$DISK" >/dev/null
  sgdisk -n 3:0:+4G     -t 3:8300 -c 3:LRD-ROOT-A  "$DISK" >/dev/null
  sgdisk -n 4:0:+4G     -t 4:8300 -c 4:LRD-ROOT-B  "$DISK" >/dev/null
  sgdisk -n 5:0:+4G     -t 5:8300 -c 5:LRD-STORE   "$DISK" >/dev/null
  sgdisk -n 6:0:+2G     -t 6:8300 -c 6:LRD-OVERLAY "$DISK" >/dev/null
  sgdisk -n 7:0:+2G     -t 7:8300 -c 7:LRD-RECOVERY "$DISK" >/dev/null
  sgdisk -n 8:0:0       -t 8:8300 -c 8:LRD-DATA    "$DISK" >/dev/null
else
  DATA_PARTNUM=7
  sgdisk -n 1:0:+512M   -t 1:ef00 -c 1:LRD-EFI     "$DISK" >/dev/null
  sgdisk -n 2:0:+1G     -t 2:8300 -c 2:LRD-BOOT    "$DISK" >/dev/null
  sgdisk -n 3:0:+6G     -t 3:8300 -c 3:LRD-ROOT    "$DISK" >/dev/null
  sgdisk -n 4:0:+2G     -t 4:8300 -c 4:LRD-STORE   "$DISK" >/dev/null
  sgdisk -n 5:0:+1G     -t 5:8300 -c 5:LRD-OVERLAY "$DISK" >/dev/null
  sgdisk -n 6:0:+2G     -t 6:8300 -c 6:LRD-RECOVERY "$DISK" >/dev/null
  sgdisk -n 7:0:0       -t 7:8300 -c 7:LRD-DATA    "$DISK" >/dev/null
fi

partprobe "$DISK" 2>/dev/null || blockdev --rereadpt "$DISK" 2>/dev/null || true
sleep 1

P_EFI="$(part "$DISK" 1)"
P_BOOT="$(part "$DISK" 2)"
P_DATA_RAW="$(part "$DISK" "$DATA_PARTNUM")"

say "formatting filesystems"
mkfs.vfat -F32 -n LRD-EFI "$P_EFI" >/dev/null
mkfs.ext4 -q -F -L LRD-BOOT "$P_BOOT"

CRYPT=""
if [ "$LUKS" = 1 ]; then
  say "configuring LUKS2 encryption on data partition"
  if [ -n "$OPT_PASS" ]; then
    PASS="$OPT_PASS"
  elif [ "$AUTO" = 1 ]; then
    PASS="libredroid"
  else
    echo -n "encryption passphrase: "; read -rs PASS; echo
  fi
  printf '%s' "$PASS" | cryptsetup luksFormat --type luks2 --pbkdf argon2id --batch-mode -q "$P_DATA_RAW" -
  printf '%s' "$PASS" | cryptsetup open "$P_DATA_RAW" lrd-data -
  CRYPT=/dev/mapper/lrd-data
fi
DATA="${CRYPT:-$P_DATA_RAW}"
mkfs.ext4 -q -F -L LRD-DATA "$DATA"

if [ "$LAYOUT" = "a/b slots" ] || [ "$LAYOUT" = "ab" ]; then
  mkfs.ext4 -q -F -L LRD-ROOT-A "$(part "$DISK" 3)"
  mkfs.ext4 -q -F -L LRD-ROOT-B "$(part "$DISK" 4)"
  mkfs.ext4 -q -F -L LRD-STORE   "$(part "$DISK" 5)"
  mkfs.ext4 -q -F -L LRD-OVERLAY "$(part "$DISK" 6)"
  mkfs.ext4 -q -F -L LRD-RECOVERY "$(part "$DISK" 7)"
else
  mkfs.ext4 -q -F -L LRD-ROOT    "$(part "$DISK" 3)"
  mkfs.ext4 -q -F -L LRD-STORE   "$(part "$DISK" 4)"
  mkfs.ext4 -q -F -L LRD-OVERLAY "$(part "$DISK" 5)"
  mkfs.ext4 -q -F -L LRD-RECOVERY "$(part "$DISK" 6)"
fi

# ---------- 4. rootfs installation ----------
say "deploying root filesystem to target disk"
ROOTPART="$(blkid -L LRD-ROOT-A 2>/dev/null || blkid -L LRD-ROOT || part "$DISK" 3)"
mkdir -p /target
mount "$ROOTPART" /target

if [ -f "$SOURCE/lrd-rootfs.squashfs" ]; then
  say "extracting squashfs from $SOURCE/lrd-rootfs.squashfs"
  unsquashfs -f -d /target "$SOURCE/lrd-rootfs.squashfs" >/dev/null
elif [ -f "$SOURCE/filesystem.squashfs" ]; then
  say "extracting squashfs from $SOURCE/filesystem.squashfs"
  unsquashfs -f -d /target "$SOURCE/filesystem.squashfs" >/dev/null
elif [ -f "/run/live/medium/live/filesystem.squashfs" ]; then
  say "extracting squashfs from live ISO medium"
  unsquashfs -f -d /target "/run/live/medium/live/filesystem.squashfs" >/dev/null
elif [ -d "$SOURCE" ] && [ -f "$SOURCE/etc/os-release" ]; then
  say "syncing rootfs tree from $SOURCE"
  rsync -aHAX --info=progress2 "$SOURCE/" /target/
else
  say "cloning running system rootfs into bare-metal target..."
  rsync -aHAX --exclude={"/dev/*","/proc/*","/sys/*","/tmp/*","/run/*","/mnt/*","/media/*","/lost+found","/target/*","/target"} / /target/ 2>/dev/null || true
fi

mkdir -p /target/{boot/efi,store,overlay,data,proc,sys,dev,run,mnt,tmp}
chmod 1777 /target/tmp
mount "$P_EFI" /target/boot/efi
mount "$P_BOOT" /target/boot
mount "$(blkid -L LRD-STORE || part "$DISK" 4)" /target/store 2>/dev/null || true
mount "$(blkid -L LRD-OVERLAY || part "$DISK" 5)" /target/overlay 2>/dev/null || true
mount "$DATA" /target/data

# ---------- 5. identity, fstab & crypttab ----------
say "generating hardware identity and persistent fstab"
{
  echo "$HOST" > /target/etc/hostname
  printf '127.0.0.1\tlocalhost\n127.0.1.1\t%s\n' "$HOST" > /target/etc/hosts
  mkdir -p /target/etc/lrd
  echo "LRD_INSTALLED=$(date -Is 2>/dev/null || date)" > /target/etc/lrd/install.info
  echo "LRD_LAYOUT=$LAYOUT" >> /target/etc/lrd/install.info
  echo "LRD_LUKS=$LUKS" >> /target/etc/lrd/install.info
} 2>/dev/null || true

ROOTUUID="$(blkid -s UUID -o value "$ROOTPART" 2>/dev/null || blkid -s PARTUUID -o value "$ROOTPART")"
BOOTUUID="$(blkid -s UUID -o value "$P_BOOT" 2>/dev/null || blkid -s PARTUUID -o value "$P_BOOT")"
EFIUUID="$(blkid -s UUID -o value "$P_EFI" 2>/dev/null || blkid -s PARTUUID -o value "$P_EFI")"
STOREUUID="$(blkid -s UUID -o value "$(blkid -L LRD-STORE 2>/dev/null || echo "")" 2>/dev/null || echo "")"
OVERUUID="$(blkid -s UUID -o value "$(blkid -L LRD-OVERLAY 2>/dev/null || echo "")" 2>/dev/null || echo "")"
DATAUUID="$(blkid -s UUID -o value "$DATA" 2>/dev/null || echo "")"

{
  echo "UUID=$ROOTUUID  /          ext4  ro,noatime,errors=remount-ro 0 1"
  echo "UUID=$BOOTUUID  /boot      ext4  defaults,noatime             0 2"
  echo "UUID=$EFIUUID   /boot/efi  vfat  umask=0077                   0 2"
  [ -n "$STOREUUID" ] && echo "UUID=$STOREUUID /store     ext4  defaults,noatime             0 2"
  [ -n "$OVERUUID" ] && echo "UUID=$OVERUUID  /overlay   ext4  defaults,noatime             0 2"
  [ -n "$DATAUUID" ] && echo "UUID=$DATAUUID  /data      ext4  defaults,noatime             0 2"
  echo "tmpfs           /tmp       tmpfs defaults,nosuid,nodev,size=2G 0 0"
} > /target/etc/fstab

if [ "$LUKS" = 1 ]; then
  DATAUUIDRAW="$(blkid -s UUID -o value "$P_DATA_RAW")"
  mkdir -p /target/etc/cryptsetup
  echo "lrd-data UUID=$DATAUUIDRAW none luks,discard" > /target/etc/crypttab
fi

# ---------- 6. bootloader installation (UEFI + BIOS) ----------
say "installing multi-architecture bootloader stack"
ARCH="$(uname -m)"
IS_EFI=0
[ -d /sys/firmware/efi ] && IS_EFI=1

mkdir -p /target/boot/efi/EFI/BOOT \
         /target/boot/efi/EFI/systemd \
         /target/boot/efi/loader/entries \
         /target/boot/grub \
         /target/boot/extlinux

# Resolve kernel and initramfs binaries
KIMG="$(ls /target/boot/vmlinuz-* 2>/dev/null | head -1)"
if [ -z "$KIMG" ]; then
  for cand in /run/live/vmlinuz /run/live/medium/live/vmlinuz /boot/vmlinuz-$(uname -r) /boot/vmlinuz /target/vmlinuz; do
    if [ -r "$cand" ] && [ -s "$cand" ]; then
      cp -f "$cand" /target/boot/vmlinuz
      KIMG="/target/boot/vmlinuz"
      break
    fi
  done
fi

INITRD_SRC="$(ls /target/boot/initrd.img-* /target/boot/initramfs*.img 2>/dev/null | head -1)"
if [ -z "$INITRD_SRC" ]; then
  for cand in /run/live/initrd.img /run/live/medium/live/initrd.img /boot/initrd.img-$(uname -r) /boot/initramfs-sovereign.img /target/initrd.img; do
    if [ -r "$cand" ] && [ -s "$cand" ]; then
      cp -f "$cand" /target/boot/initramfs.img
      INITRD_SRC="/target/boot/initramfs.img"
      break
    fi
  done
fi

# Mirror kernel & initrd to /target/boot and /target/boot/efi for both GRUB & systemd-boot
[ -n "$KIMG" ] && cp -f "$KIMG" /target/boot/vmlinuz 2>/dev/null && cp -f "$KIMG" /target/boot/efi/vmlinuz 2>/dev/null || true
[ -n "$INITRD_SRC" ] && cp -f "$INITRD_SRC" /target/boot/initramfs.img 2>/dev/null && cp -f "$INITRD_SRC" /target/boot/efi/initramfs.img 2>/dev/null || true

# 6a. Install UEFI bootloader binaries
if [ "$ARCH" = "x86_64" ]; then
  for d in /target/usr/lib/systemd/boot/efi /usr/lib/systemd/boot/efi; do
    if [ -f "$d/systemd-bootx64.efi" ]; then
      cp -f "$d/systemd-bootx64.efi" /target/boot/efi/EFI/BOOT/BOOTX64.EFI
      cp -f "$d/systemd-bootx64.efi" /target/boot/efi/EFI/systemd/systemd-bootx64.efi
      break
    fi
  done
  for d in /target/usr/lib/systemd/boot/efi /usr/lib/systemd/boot/efi; do
    if [ -f "$d/systemd-bootia32.efi" ]; then
      cp -f "$d/systemd-bootia32.efi" /target/boot/efi/EFI/BOOT/BOOTIA32.EFI
      break
    fi
  done
  if command -v grub-install >/dev/null 2>&1; then
    grub-install --target=x86_64-efi --efi-directory=/target/boot/efi --boot-directory=/target/boot --removable 2>/dev/null || true
    grub-install --target=i386-efi --efi-directory=/target/boot/efi --boot-directory=/target/boot --removable 2>/dev/null || true
  fi
elif [ "$ARCH" = "aarch64" ]; then
  for d in /target/usr/lib/systemd/boot/efi /usr/lib/systemd/boot/efi; do
    if [ -f "$d/systemd-bootaa64.efi" ]; then
      cp -f "$d/systemd-bootaa64.efi" /target/boot/efi/EFI/BOOT/BOOTAA64.EFI
      break
    fi
  done
  if command -v grub-install >/dev/null 2>&1; then
    grub-install --target=arm64-efi --efi-directory=/target/boot/efi --boot-directory=/target/boot --removable 2>/dev/null || true
  fi
fi

# 6b. Install Legacy BIOS MBR bootloader
if command -v grub-install >/dev/null 2>&1; then
  say "installing GRUB for Legacy BIOS boot compatibility"
  grub-install --target=i386-pc --boot-directory=/target/boot --recheck "$DISK" 2>/dev/null || true
fi

# 6c. Generate /etc/default/grub defaults
mkdir -p /target/etc/default
cat > /target/etc/default/grub <<EOF
# LibreDroid OS Default GRUB Configuration
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="LibreDroid"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX="$ROOTARG"
GRUB_DISABLE_OS_PROBER=false
EOF

# 6c. Generate systemd-boot configuration
cat > /target/boot/efi/loader/loader.conf <<EOF
default libredroid.conf
timeout 3
console-mode max
editor no
EOF

ROOTARG="root=UUID=$ROOTUUID ro"
[ "$LUKS" = 1 ] && ROOTARG="rd.luks.name=$DATAUUIDRAW=lrd-data root=UUID=$ROOTUUID ro"

cat > /target/boot/efi/loader/entries/libredroid.conf <<EOF
title LibreDroid $VERSION
linux /vmlinuz
initrd /initramfs.img
options $ROOTARG quiet splash lrd.root=UUID=$ROOTUUID

title LibreDroid $VERSION (safe graphics nomodeset)
linux /vmlinuz
initrd /initramfs.img
options $ROOTARG nomodeset

title LibreDroid $VERSION (safe mode)
linux /vmlinuz
initrd /initramfs.img
options $ROOTARG systemd.unit=lrd-safe.target
EOF

# 6d. Generate GRUB2 configuration (for both Legacy BIOS and GRUB-EFI)
cat > /target/boot/grub/grub.cfg <<EOF
set default="0"
set timeout=5

insmod efi_gop
insmod efi_uga
insmod video_bochs
insmod video_cirrus
insmod all_video
insmod font
insmod ext2
insmod part_gpt

set menu_color_normal=white/black
set menu_color_highlight=black/light-gray

menuentry "LibreDroid OS $VERSION" --class os {
    search --no-floppy --fs-uuid --set=root $BOOTUUID
    linux /vmlinuz $ROOTARG quiet splash
    initrd /initramfs.img
}

menuentry "LibreDroid OS $VERSION (Safe Graphics - nomodeset)" --class os {
    search --no-floppy --fs-uuid --set=root $BOOTUUID
    linux /vmlinuz $ROOTARG nomodeset
    initrd /initramfs.img
}

menuentry "LibreDroid OS $VERSION (Safe Mode Recovery)" --class os {
    search --no-floppy --fs-uuid --set=root $BOOTUUID
    linux /vmlinuz $ROOTARG systemd.unit=lrd-safe.target
    initrd /initramfs.img
}
EOF

# 6e. Generate extlinux configuration for ARM64 SBCs
cat > /target/boot/extlinux/extlinux.conf <<EOF
timeout 20
default libredroid

label libredroid
    menu label LibreDroid OS $VERSION (Mainline ARM64)
    linux /vmlinuz
    initrd /initramfs.img
    append $ROOTARG quiet splash
EOF

# 6f. Register EFI boot entry in NVRAM if available
if [ "$IS_EFI" -eq 1 ] && command -v efibootmgr >/dev/null 2>&1; then
  loader_path='\EFI\BOOT\BOOTX64.EFI'
  [ "$ARCH" = "aarch64" ] && loader_path='\EFI\BOOT\BOOTAA64.EFI'
  efibootmgr --create --disk "$DISK" --part 1 --label "LibreDroid OS" --loader "$loader_path" 2>/dev/null || true
fi

# ---------- 7. bare-metal hardware configuration ----------
say "injecting bare-metal hardware & driver auto-configuration"
mkdir -p /target/etc/modules-load.d /target/etc/udev/rules.d /target/etc/NetworkManager/system-connections /target/var/lib/lrd

# Storage, display, and input modules for bare metal
cat > /target/etc/modules-load.d/baremetal.conf <<EOF
# Core storage controllers
nvme
ahci
vmd
sd_mod
usb_storage
uas
xhci_pci
ehci_pci

# eMMC Flash & SD card controllers (laptops, convertibles, SBCs)
mmc_core
mmc_block
sdhci
sdhci_pci
sdhci_acpi

# Filesystem and device mapper
ext4
vfat
squashfs
overlay
dm_mod
dm_crypt
dm_verity

# Virtualized fallback
virtio_blk
virtio_pci
virtio_scsi
virtio_net
virtio_gpu

# Input devices & touchscreens
hid_generic
usbhid
i2c_hid
i2c_hid_acpi
i2c_designware_platform
hid_multitouch
atkbd
psmouse

# Sound
snd_hda_intel
snd_usb_audio

# Wired network
e1000e
e1000
igb
igc
r8169
tg3
alx

# Wireless network
iwlwifi
rtw88_core
rtw89_core
ath9k
ath10k_core
EOF

# Udev permissions for bare metal GPU and input
cat > /target/etc/udev/rules.d/99-baremetal.rules <<EOF
KERNEL=="card*", SUBSYSTEM=="drm", GROUP="video", MODE="0660"
KERNEL=="renderD*", SUBSYSTEM=="drm", GROUP="render", MODE="0666"
KERNEL=="event*", SUBSYSTEM=="input", GROUP="input", MODE="0660"
KERNEL=="mouse*|mice", SUBSYSTEM=="input", GROUP="input", MODE="0660"
KERNEL=="js*", SUBSYSTEM=="input", GROUP="input", MODE="0660"
KERNEL=="fb*", GROUP="video", MODE="0660"
KERNEL=="rtc0", GROUP="root", MODE="0664"
EOF

# NetworkManager automatic wired DHCP profile
cat > /target/etc/NetworkManager/system-connections/Wired-Ethernet.nmconnection <<EOF
[connection]
id=Wired Ethernet
type=ethernet
autoconnect=true

[ipv4]
method=auto

[ipv6]
method=auto
EOF
chmod 600 /target/etc/NetworkManager/system-connections/Wired-Ethernet.nmconnection

# Set initial display variant to drm-atomic with auto-fallback
echo "drm-atomic" > /target/var/lib/lrd/display.variant

# ---------- 8. user creation ----------
say "configuring user $USERNAME"
chroot /target /usr/sbin/lrd-user create "$USERNAME" --admin --shell /bin/bash --autologin 2>/dev/null || \
  { chroot /target useradd -m -G sudo,audio,video,render,input "$USERNAME" 2>/dev/null || true; }
echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" > /target/etc/sudoers.d/lrd-user
chmod 440 /target/etc/sudoers.d/lrd-user

USER_PASS="${OPT_PASS:-$(head -c 12 /dev/urandom 2>/dev/null | base64 2>/dev/null || echo "libredroid")}"
printf 'root:%s\n%s:%s\n' "$USER_PASS" "$USERNAME" "$USER_PASS" | chroot /target chpasswd 2>/dev/null || true

# ---------- 9. recovery partition setup ----------
if [ "$RECOVERY" = 1 ] && [ -d /target/usr/share/lrd/recovery ]; then
  say "syncing recovery partition files"
  mount "$(blkid -L LRD-RECOVERY)" /mnt 2>/dev/null || { mkdir -p /mnt && mount "$(blkid -L LRD-RECOVERY)" /mnt 2>/dev/null || true; }
  rsync -aHAX /target/usr/share/lrd/recovery/ /mnt/ 2>/dev/null || true
  umount /mnt 2>/dev/null || true
fi

# ---------- 10. synchronization and cleanup ----------
say "synchronizing storage caches and finalizing"
sync
for m in /target/data /target/overlay /target/store /target/boot/efi /target/boot /target; do
  umount "$m" 2>/dev/null || true
done
[ "$LUKS" = 1 ] && cryptsetup close lrd-data 2>/dev/null || true

cat <<EOF

======================================================================
  BARE-METAL INSTALLATION SUCCESSFUL!
======================================================================

  Target Disk: $DISK (${SZ_GB} GB)
  Firmware:    $([ "$IS_EFI" -eq 1 ] && echo "UEFI (systemd-boot & GRUB EFI configured)" || echo "Legacy BIOS (GRUB MBR configured)")
  Arch:        $ARCH
  User:        $USERNAME

  You may now remove your USB installation media and reboot.
  The system will automatically initialize display and hardware on first boot.

EOF
