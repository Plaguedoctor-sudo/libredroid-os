[Unit]
Description=LibreDroid — initialise the bootloader control block
DefaultDependencies=no
After=systemd-remount-fs.service
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/dev /var/lib/lrd /run/lrd
ExecStart=/bin/sh -c 'if command -v lrd-bootcount >/dev/null 2>&1; then lrd-bootcount --status; elif [ -x /usr/sbin/lrd-bootcount ]; then /usr/sbin/lrd-bootcount --status; fi'

[Install]
WantedBy=sysinit.target
