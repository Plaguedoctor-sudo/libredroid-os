#!/usr/sbin/nft -f
# ==============================================================================
# LibreDroid Anti-Surveillance & Telemetry Defense nftables Ruleset
# os/build/config/includes.chroot/etc/nftables.d/lrd-telemetry.nft
#
# Intercepts DNS queries, neutralizes DoH/DoT bypasses, and routes tracker traffic
# to the local poisoner daemon.
# ==============================================================================

table inet lrd_telemetry {
    set doh_resolvers {
        type ipv4_addr
        elements = {
            1.1.1.1, 1.0.0.1,
            8.8.8.8, 8.8.4.4,
            9.9.9.9, 149.112.112.112
        }
    }

    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;

        # Redirect container/guest DNS requests (port 53) to lrd-dnsd (port 5353)
        udp dport 53 counter redirect to :5353
        tcp dport 53 counter redirect to :5353

        # Redirect HTTP traffic targeted at tracker sink IP (127.0.0.2) to lrd-poisoner (port 8088)
        ip daddr 127.0.0.2 tcp dport { 80, 443, 8080 } counter redirect to :8088
    }

    chain output_nat {
        type nat hook output priority dstnat; policy accept;

        # Local process DNS redirection for non-root / untrusted users
        # Exclude lrd-dnsd itself (runs under UID or queries upstream)
        skuid != 0 udp dport 53 counter redirect to :5353
        skuid != 0 tcp dport 53 counter redirect to :5353

        # Redirect tracker sinks to local poisoner
        ip daddr 127.0.0.2 tcp dport { 80, 443, 8080 } counter redirect to :8088
    }

    chain filter_forward {
        type filter hook forward priority 0; policy accept;

        # Block encrypted DNS-over-TLS (DoT port 853) bypasses
        tcp dport 853 counter reject with tcp reset
        udp dport 853 counter drop

        # Block direct DoH leaks to public resolvers on port 443
        ip daddr @doh_resolvers tcp dport 443 counter reject with tcp reset

        # Drop telemetry domains attempting raw DNS tunneling
        udp dport 5353 ip daddr != 127.0.0.1 counter drop
    }

    chain filter_output {
        type filter hook output priority 0; policy accept;

        # Block local unprivileged apps attempting DoT on port 853
        skuid != 0 tcp dport 853 counter reject with tcp reset
        skuid != 0 udp dport 853 counter drop

        # Block local unprivileged apps bypassing to public DoH resolvers on port 443
        skuid != 0 ip daddr @doh_resolvers tcp dport 443 counter reject with tcp reset
    }
}
