#!/usr/bin/env bash
# lrd-repo — build, sign and publish the OS's own apt repository.
#   init | add <deb...> | publish | verify
set -Eeuo pipefail
REPO="${LRD_REPO:-/var/lib/lrd/repo}"
KEY="${LRD_SIGN_KEY:?set LRD_SIGN_KEY}"
DIST="${LRD_DIST:-lrd}"
COMP="${LRD_COMP:-main}"
ARCH="$(dpkg --print-architecture)"
say(){ printf '\033[1;36m::\033[0m %s\n' "$*"; }

case "${1:-verify}" in
init)
  mkdir -p "$REPO"/{conf,dists,pool/$COMP,build}
  cat > "$REPO/conf/distributions" <<EOF
Origin: LibreDroid
Label: LibreDroid OS
Codename: $DIST
Architectures: $ARCH source
Components: $COMP
Description: LibreDroid OS packages
SignWith: $KEY
EOF
  cat > "$REPO/conf/options" <<'EOF'
verbose
basedir .
EOF
  say "repo initialised at $REPO"
  ;;

add)
  shift
  [ $# -gt 0 ] || { echo "usage: lrd-repo add <deb...>"; exit 2; }
  for d in "$@"; do
    [ -f "$d" ] || { echo "skip $d"; continue; }
    pkg="$(dpkg-deb -f "$d" Package)"
    ver="$(dpkg-deb -f "$d" Version)"
    arch="$(dpkg-deb -f "$d" Architecture)"
    mkdir -p "$REPO/pool/$COMP"
    cp -f "$d" "$REPO/pool/$COMP/${pkg}_${ver}_${arch}.deb"
    say "added $pkg $ver $arch"
  done
  ;;

publish)
  command -v reprepro >/dev/null || { echo "apt install reprepro"; exit 1; }
  cd "$REPO"
  # clear and re-add from the pool so the index always matches reality
  rm -rf dists db
  reprepro --basedir "$REPO" export "$DIST" 2>/dev/null || true
  for d in "$REPO"/pool/"$COMP"/*.deb; do
    [ -f "$d" ] || continue
    reprepro --basedir "$REPO" includedeb "$DIST" "$d" >/dev/null
  done
  reprepro --basedir "$REPO" export "$DIST"
  say "published $(ls -1 "$REPO"/pool/"$COMP"/*.deb 2>/dev/null | wc -l) packages"
  # ship the key so devices can verify
  mkdir -p "$REPO/keys"
  gpg --batch --yes --armor --export "$KEY" > "$REPO/keys/lrd-archive-key.asc"
  ;;

verify)
  cd "$REPO"
  [ -f dists/$DIST/Release.gpg ] || { echo "not signed — run publish"; exit 1; }
  gpg --verify dists/$DIST/Release.gpg dists/$DIST/Release && say "Release signature ok"
  ;;

*) echo "usage: lrd-repo {init|add <deb...>|publish|verify}"; exit 2 ;;
esac
