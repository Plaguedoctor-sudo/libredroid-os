#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# LibreDroid Tier 2 MicroVM Invocation Wrapper
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PARENT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ -f "$PARENT_DIR/domain/lrd-microvm" ]; then
    exec "$PARENT_DIR/domain/lrd-microvm" "$@"
else
    echo "Error: domain orchestrator not found at $PARENT_DIR/domain/lrd-microvm" >&2
    exit 1
fi
