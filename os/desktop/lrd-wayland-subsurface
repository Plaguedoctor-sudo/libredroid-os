#!/usr/bin/env bash
# lrd-wayland-subsurface — Direct zero-copy Wayland subsurface & multi-window orchestrator
# Completely replaces noVNC and WebSockets with direct DRI3/DMABUF Wayland compositing
set -euo pipefail

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
HOST_SOCKET="${RUNTIME_DIR}/${WAYLAND_DISPLAY}"

echo "[lrd-wayland] Initializing direct Wayland zero-copy subsurface pipeline..."

# 1. Verify Host Compositor Socket
for i in $(seq 1 15); do
  if [ -e "$HOST_SOCKET" ] || [ -S "$HOST_SOCKET" ]; then
    echo "[lrd-wayland] Host Wayland compositor socket active: $HOST_SOCKET"
    break
  fi
  sleep 0.5
done

if [ ! -e "$HOST_SOCKET" ] && [ ! -S "$HOST_SOCKET" ]; then
  echo "[lrd-wayland] Warning: Host Wayland socket not yet available at $HOST_SOCKET"
fi

# 2. Configure Waydroid for Native Multi-Window Wayland Compositing
if command -v waydroid >/dev/null 2>&1; then
  echo "[lrd-wayland] Configuring Waydroid for native Wayland subsurfaces..."
  waydroid prop set persist.waydroid.multi_windows true 2>/dev/null || true
  waydroid prop set persist.waydroid.cursor_on_subsurface true 2>/dev/null || true
  waydroid prop set persist.waydroid.suspend false 2>/dev/null || true
  # Set Waydroid to route directly to host compositor
  export WAYDROID_WAYLAND_DISPLAY="$WAYLAND_DISPLAY"
fi

# 3. Provision Domain Wayland Sockets (Vault, Tor, Workstation, Android)
DOMAINS="vault tor-gw workstation android disposable"
mkdir -p "${RUNTIME_DIR}/domains"
chmod 0700 "${RUNTIME_DIR}/domains"

for dom in $DOMAINS; do
  dom_sock="${RUNTIME_DIR}/wayland-domain-${dom}"
  if [ ! -e "$dom_sock" ]; then
    ln -sf "$HOST_SOCKET" "$dom_sock"
  fi
done

# 4. If Sommelier is installed, run zero-copy window proxy
if command -v sommelier >/dev/null 2>&1; then
  echo "[lrd-wayland] Launching sommelier zero-copy Wayland forwarder..."
  sommelier -X --peer-cmd-prefix="systemd-cat -t sommelier" \
    --virtgpu-channel=true \
    --scale=1.0 &
fi

echo "[lrd-wayland] Direct Wayland subsurface pipeline active. Zero VNC overhead."
