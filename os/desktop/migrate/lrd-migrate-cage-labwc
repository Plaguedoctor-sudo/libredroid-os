#!/usr/bin/env bash
# lrd-migrate-cage-labwc — move from cage (one client) to labwc (a compositor).
# Nothing else on this list works until this is done.
#
#   plan | run | verify | rollback | status
set -Eeuo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
STAMP=/var/lib/lrd/migrate
BACKUP="$STAMP/pre-labwc"
LOG=/var/log/lrd/migrate.log
say(){ printf '\033[1;36m::\033[0m %s\n' "$*"; }
ok(){ printf '\033[1;32m ok\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die(){ printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }
have(){ command -v "$1" >/dev/null 2>&1; }
case "${1:-plan}" in
  run|rollback)
    [ "$(id -u)" = 0 ] || die "run as root"
    mkdir -p "$STAMP"
    exec > >(tee -a "$LOG") 2>&1
    ;;
  *)
    mkdir -p "$STAMP" 2>/dev/null || true
    ;;
esac

need_pkgs=(labwc wlrctl wvkbd fcitx5 xdg-desktop-portal-wlr xdg-desktop-portal-gtk
           xdg-desktop-portal mako-notifier lxpolkit grim slurp wl-mirror
           gvfs-backends udisks2 at-spi2-core speech-dispatcher espeak-ng orca
           flatpak bubblewrap xdg-desktop-portal-gnome pipewire wireplumber)
optional_pkgs=(squeekboard wayland-utils brightnessctl wlr-randr)

preflight() {
  say "preflight"
  [ -f /etc/lrd/adapt.json ] || [ -f /run/lrd/adapt.json ] || warn "no adaptation report — is this really a LibreDroid system?"
  # the session needs a dbus daemon and a runtime dir
  have dbus-daemon || die "dbus-daemon missing (apt install dbus)"
  have dbus-launch || have dbus-run-session || die "dbus-launch missing (apt install dbus-x11)"
  have systemctl || die "systemd missing"
  # userns, because flatpak and bubblewrap need it
  [ "$(cat /proc/sys/kernel/unprivileged_userns_clone 2>/dev/null || echo 1)" = 1 ] \
    || warn "user namespaces are off — flatpak will not work"
  # display path must exist or the compositor cannot start
  if [ ! -e /dev/dri/card0 ] && [ ! -e /dev/fb0 ]; then
    die "no display device — the kernel has no working output"
  fi
  [ -e /dev/dri/card0 ] && ok "DRM present" || warn "no DRM, only fbdev"
  # enough room
  free="$(df -Pk / | awk 'NR==2{print $4}')"
  [ "$free" -gt 500000 ] || die "less than 500MB free on /"
  ok "preflight clean"
}

do_plan() {
  echo "this migration will:"
  echo "  1. back up /etc/systemd/system/cage.service* to $BACKUP"
  echo "  2. install: ${need_pkgs[*]}"
  echo "  3. install lrd-session, labwc config, lrd-wm, lrd-osk, lrd-im, lrd-a11y"
  echo "  4. write /etc/xdg/xdg-desktop-portal/portals.conf with the CORRECT split"
  echo "  5. disable cage.service, enable labwc.service"
  echo "  6. reboot, then verify"
  echo
  echo "the portal split is the fiddly part:"
  echo "  FileChooser/Notification/Print -> -gtk   (because -wlr does NOT implement them)"
  echo "  Screenshot/ScreenCast          -> -wlr   (because -gtk cannot on wlroots)"
  echo
  echo "rollback: lrd-migrate-cage-labwc rollback"
}

do_run() {
  preflight
  say "backing up"
  mkdir -p "$BACKUP"
  for f in /etc/systemd/system/cage.service /etc/systemd/system/cage.service.d; do
    [ -e "$f" ] && cp -a "$f" "$BACKUP/" 2>/dev/null || true
  done
  cp -a /etc/xdg/xdg-desktop-portal "$BACKUP/portals-pre" 2>/dev/null || true
  # record what was active so a rollback restores the exact state
  { echo "was_cage_enabled=$(systemctl is-enabled cage.service 2>/dev/null || echo unknown)"
    echo "was_cage_active=$(systemctl is-active cage.service 2>/dev/null || echo unknown)"
    echo "at=$(date -Is)"
  } > "$BACKUP/state.txt"
  ok "backed up to $BACKUP"

  say "installing packages"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq || warn "apt update failed — continuing with the local cache"
  apt-get install -y --no-install-recommends "${need_pkgs[@]}" || die "package install failed"
  for p in "${optional_pkgs[@]}"; do apt-get install -y --no-install-recommends "$p" 2>/dev/null || true; done
  ok "packages installed"

  say "installing session, compositor config, controllers"
  install -Dm755 "$HERE/../lrd-session"        /usr/lib/lrd/lrd-session
  install -Dm755 "$HERE/../lrd-shell-launch"   /usr/bin/lrd-shell-launch
  install -Dm755 "$HERE/../lrd-wm"             /usr/bin/lrd-wm
  install -Dm755 "$HERE/../lrd-apps-registry"  /usr/bin/lrd-apps-registry
  install -Dm755 "$HERE/../../input/lrd-osk"   /usr/bin/lrd-osk
  install -Dm755 "$HERE/../../input/lrd-im"    /usr/bin/lrd-im
  install -Dm755 "$HERE/../../a11y/lrd-a11y"   /usr/bin/lrd-a11y
  install -Dm755 "$HERE/../../fs/lrd-mount"    /usr/bin/lrd-mount
  install -Dm755 "$HERE/../../fs/lrd-trash"    /usr/bin/lrd-trash
  install -Dm755 "$HERE/../../desktop/flatpak/lrd-flatpak" /usr/bin/lrd-flatpak
  mkdir -p /etc/xdg/labwc
  for f in rc.xml menu.xml environment autostart; do
    [ -f "$HERE/../labwc/$f" ] && install -Dm644 "$HERE/../labwc/$f" "/etc/xdg/labwc/$f"
  done
  [ -f /etc/xdg/labwc/autostart ] && chmod 755 /etc/xdg/labwc/autostart
  install -Dm644 "$HERE/../labwc/labwc.service" /etc/systemd/system/labwc.service
  ok "files installed"

  say "portals — the split that matters"
  mkdir -p /etc/xdg/xdg-desktop-portal
  cat > /etc/xdg/xdg-desktop-portal/portals.conf <<'EOF'
# The split is load-bearing. -wlr implements Screenshot/ScreenCast ONLY.
# -gtk implements FileChooser/Notification/Print/AppChooser.
# Route the wrong way and file pickers fail silently with no error anywhere.
[preferred]
default=gtk
org.freedesktop.impl.portal.FileChooser=gtk
org.freedesktop.impl.portal.Notification=gtk
org.freedesktop.impl.portal.Print=gtk
org.freedesktop.impl.portal.AppChooser=gtk
org.freedesktop.impl.portal.Accessibility=gtk
org.freedesktop.impl.portal.Screenshot=wlr
org.freedesktop.impl.portal.ScreenCast=wlr
org.freedesktop.impl.portal.RemoteDesktop=wlr
EOF
  ok "portals.conf written"

  say "mako + polkit + mime handlers"
  mkdir -p /etc/xdg/mako
  cat > /etc/xdg/mako/lrd.conf <<'EOF'
font=Noto Sans 11
background-color=#1a1a1aee
text-color=#e4e4e4
border-color=#333333
border-size=1
border-radius=6
width=360
height=120
margin=8
padding=10
anchor=top-right
default-timeout=6000
group-by=app-name
EOF
  install -Dm644 "$HERE/../../fs/lrd-files.desktop" /usr/share/applications/lrd-files.desktop 2>/dev/null || true
  mkdir -p /etc/xdg
  cat > /etc/xdg/mimeapps.list <<'EOF'
[Default Applications]
inode/directory=lrd-files.desktop
text/plain=mousepad.desktop
application/pdf=zathura.desktop
image/png=imv.desktop
video/mp4=mpv.desktop
application/vnd.android.package-archive=lrd-apk.desktop
EOF
  command -v update-desktop-database >/dev/null && update-desktop-database -q /usr/share/applications 2>/dev/null || true
  ok "helpers configured"

  say "switching the unit"
  systemctl daemon-reload
  systemctl disable cage.service 2>/dev/null || true
  systemctl enable labwc.service || die "could not enable labwc.service"
  # keep cage available but inert
  ok "labwc.service enabled, cage.service disabled"

  say "static verify (before reboot)"
  "$0" verify --static || die "static verify failed — run 'rollback'"
  ok "migration staged"
  echo
  echo "  reboot now, then run: lrd-migrate-cage-labwc verify"
  echo "  if the session does not come up: ctrl+alt+F2, then 'lrd-migrate-cage-labwc rollback'"
}

do_verify() {
  static=0; [ "${2:-}" = --static ] && static=1
  fail=0
  chk(){ if bash -c "$2" >/dev/null 2>&1; then ok "$1"; else printf '\033[1;31mfail\033[0m %s\n' "$1"; fail=$((fail+1)); fi; }

  chk "labwc installed"        "command -v labwc"
  chk "session script installed" "test -x /usr/lib/lrd/lrd-session"
  chk "labwc config present"   "test -s /etc/xdg/labwc/rc.xml"
  chk "autostart present"      "test -x /etc/xdg/labwc/autostart"
  chk "lrd-wm installed"       "command -v lrd-wm"
  chk "lrd-osk installed"      "command -v lrd-osk"
  chk "portals.conf correct"   "grep -q 'FileChooser=gtk' /etc/xdg/xdg-desktop-portal/portals.conf"
  chk "portals.conf screencast" "grep -q 'ScreenCast=wlr' /etc/xdg/xdg-desktop-portal/portals.conf"
  chk "labwc.service enabled"  "systemctl is-enabled labwc.service"
  chk "cage.service disabled"  "! systemctl is-enabled cage.service 2>/dev/null"
  chk "no cage autostart left"  "! grep -rq 'cage' /etc/systemd/system/graphical.target.wants/ 2>/dev/null"

  if [ "$static" = 0 ]; then
    chk "session bus exists"    "test -S /run/user/*/bus -o -n \"\${DBUS_SESSION_BUS_ADDRESS:-}\""
    chk "compositor running"    "pgrep -x labwc"
    chk "shell running"         "pgrep -f 'chromium.*3001'"
    chk "portal running"        "pgrep -x xdg-desktop-portal"
    chk "portal backend running" "pgrep -x xdg-desktop-portal-gtk"
    chk "no cage running"       "! pgrep -x cage"
    chk "one toplevel min"      "wlrctl toplevel list 2>/dev/null | grep -q ."
  fi

  echo
  if [ "$fail" -eq 0 ]; then
    ok "migration verified"
    echo "VERIFIED" > "$STAMP/state"
    return 0
  fi
  echo "$fail check(s) failed"
  echo "FAILED" > "$STAMP/state"
  return 1
}

do_rollback() {
  say "rolling back to cage"
  [ -d "$BACKUP" ] || die "no backup at $BACKUP"
  systemctl disable --now labwc.service 2>/dev/null || true
  [ -d "$BACKUP/cage.service.d" ] && cp -a "$BACKUP/cage.service.d" /etc/systemd/system/ 2>/dev/null || true
  [ -f "$BACKUP/cage.service" ] && cp -a "$BACKUP/cage.service" /etc/systemd/system/ 2>/dev/null || true
  [ -d "$BACKUP/portals-pre" ] && cp -a "$BACKUP/portals-pre/." /etc/xdg/xdg-desktop-portal/ 2>/dev/null || true
  if [ -f "$BACKUP/state.txt" ] && grep -q 'was_cage_enabled=enabled' "$BACKUP/state.txt"; then
    systemctl enable cage.service 2>/dev/null || true
  fi
  systemctl daemon-reload
  echo "ROLLEDBACK" > "$STAMP/state"
  say "cage restored — reboot"
}

case "${1:-plan}" in
  plan) do_plan ;;
  run) do_run ;;
  verify) do_verify "$@" ;;
  rollback) do_rollback ;;
  status)
    echo "state:  $(cat "$STAMP/state" 2>/dev/null || echo not-run)"
    echo "cage:   enabled=$(systemctl is-enabled cage.service 2>/dev/null || echo no) active=$(systemctl is-active cage.service 2>/dev/null || echo no)"
    echo "labwc:  enabled=$(systemctl is-enabled labwc.service 2>/dev/null || echo no) active=$(systemctl is-active labwc.service 2>/dev/null || echo no)"
    echo "compositor running: $(pgrep -x labwc >/dev/null && echo labwc || pgrep -x cage >/dev/null && echo cage || echo none)"
    ;;
  *) echo "usage: lrd-migrate-cage-labwc {plan|run|verify [--static]|rollback|status}"; exit 2 ;;
esac
