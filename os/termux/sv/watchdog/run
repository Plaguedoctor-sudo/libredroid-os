#!/data/data/com.termux/files/usr/bin/sh
exec 2>&1
. "$HOME/.lrd/etc/lrd.env"
fails=0; restarts=0; window=0
while :; do
  sleep 20
  if curl -fsS --max-time 5 "http://127.0.0.1:${LRD_PORT}/healthz" >/dev/null 2>&1; then
    fails=0
  else
    fails=$((fails+1))
    echo "[watchdog] miss $fails $(date -Is)"
    if [ "$fails" -ge 3 ]; then
      sv restart lrd; restarts=$((restarts+1)); fails=0
      echo "[watchdog] restarted lrd (n=$restarts)"
      if [ "$restarts" -ge 3 ]; then
        termux-notification --id lrd --title "LibreDroid unstable" \
          --content "3 restarts in a row — tap for recovery" \
          --action "$HOME/.lrd/bin/lrd-recover.sh" --priority high
        restarts=0
      fi
    fi
  fi
done
