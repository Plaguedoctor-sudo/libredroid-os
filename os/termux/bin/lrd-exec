#!/data/data/com.termux/files/usr/bin/bash
# lrd-exec [-p] [-r] [-t secs] [-C dir] <command...>
# Runs through the bridge so output lands in the live stream and the shell's Terminal app.
set -uo pipefail
PORT="${LRD_PORT:-3001}"
pty=1; root=0; timeout=180; cwd=""
while getopts "prt:C:" o; do case "$o" in
  p) pty=0 ;; r) root=1 ;; t) timeout="$OPTARG" ;; C) cwd="$OPTARG" ;;
esac; done
shift $((OPTIND-1))
[ $# -gt 0 ] || { echo "usage: lrd-exec [-p] [-r] [-t secs] [-C dir] <command...>"; exit 2; }

cmd="$*"
body=$(jq -nc --arg c "$cmd" --argjson p "$pty" --argjson r "$root" --argjson t "$timeout" --arg d "$cwd" \
  '{cmd:$c,pty:($p==1),root:($r==1),timeoutMs:($t*1000)} + (if $d=="" then {} else {cwd:$d} end)')

id=$(curl -fsS --max-time 8 -X POST "http://127.0.0.1:${PORT}/api/host/exec" \
  -H 'content-type: application/json' -d "$body" | jq -r .id) || { echo "bridge unreachable"; exit 3; }
[ -n "$id" ] && [ "$id" != null ] || { echo "no job id"; exit 3; }

echo "[lrd-exec $id] $cmd" >&2
curl -fsSN --max-time $((timeout + 30)) "http://127.0.0.1:${PORT}/api/events?topics=exec" 2>/dev/null |
while IFS= read -r line; do
  case "$line" in
    data:*)
      json="${line#data: }"
      [ "$(printf '%s' "$json" | jq -r .data.jobId)" = "$id" ] || continue
      type=$(printf '%s' "$json" | jq -r .data.type)
      case "$type" in
        data) printf '%s' "$json" | jq -r .data.b64 | base64 -d ;;
        exit)
          code=$(printf '%s' "$json" | jq -r .data.code)
          echo "[lrd-exec $id] exit $code" >&2
          exit "$code" ;;
      esac ;;
  esac
done
