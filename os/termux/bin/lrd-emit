#!/data/data/com.termux/files/usr/bin/bash
# lrd-emit <topic> [json]  — push an event into the live stream.
# Used by hooks, udev rules, systemd units, and the shell's own lifecycle hooks.
set -uo pipefail
PORT="${LRD_PORT:-3001}"
topic="${1:?usage: lrd-emit <topic> [json]}"
data="${2:-{\}}"
# tolerate unquoted scalars: lrd-emit power 41 -> {"value":41}
case "$data" in
  \{*|\[*) payload="$data" ;;
  true|false|null) payload="$data" ;;
  ''|*[!0-9.-]*) payload="\"$data\"" ;;
  *) payload="$data" ;;
esac

body=$(printf '{"topic":"%s","data":%s,"immediate":true}' "$topic" "$payload")
curl -fsS --max-time 4 -X POST "http://127.0.0.1:${PORT}/api/events/push" \
  -H 'content-type: application/json' -d "$body" >/dev/null 2>&1 \
  && exit 0 || exit 1
