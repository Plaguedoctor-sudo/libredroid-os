# LibreDroid I1 environment. Sourced by every service and CLI. Keep it dumb.
LRD_BACKEND=hostandroid
LRD_BIND=127.0.0.1
LRD_PORT=3001
LRD_HOME=$HOME/.lrd
LRD_STATE=$LRD_HOME/state
LRD_SHARED=$HOME/storage/shared/LibreDroid
LRD_MODELS=$LRD_HOME/models
LRD_DOMAINS=$LRD_HOME/domains
LRD_LOG=$LRD_HOME/log

# fail-closed defaults
LRD_STRICT_LOCAL=1          # bind loopback, refuse 0.0.0.0
LRD_ALLOW_PM_INSTALL=auto   # auto|root|session|ui|off
LRD_ICON_CACHE_TTL=604800

# tor (app-level)
LRD_TOR_SOCKS=127.0.0.1:9050
LRD_TOR_DNS=127.0.0.1:5353
LRD_TOR_HTTP=127.0.0.1:8118

# domain roots
LRD_DOMAIN_work=debian
LRD_DOMAIN_dispos=alpine
LRD_VAULT_IMG=$LRD_DOMAINS/vault.img

export LRD_BACKEND LRD_BIND LRD_PORT LRD_HOME LRD_STATE LRD_SHARED LRD_MODELS \
       LRD_DOMAINS LRD_LOG LRD_STRICT_LOCAL LRD_ALLOW_PM_INSTALL LRD_ICON_CACHE_TTL \
       LRD_TOR_SOCKS LRD_TOR_DNS LRD_TOR_HTTP LRD_VAULT_IMG
