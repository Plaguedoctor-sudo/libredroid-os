#!/usr/bin/env bash
# apply-modules — load the vendor modules the device needs, and prove which loaded.
# Without this, wifi, touch and panel backlight are all dead.
set -uo pipefail
STATE=/run/lrd/modules.state
mkdir -p /run/lrd
log() { echo "[apply-modules] $*"; logger -t lrd-adapt "$*" 2>/dev/null || true; }

KVER="$(uname -r)"
MODDIR="/lib/modules/$KVER"
[ -d "$MODDIR" ] || { log "no modules for $KVER (built-in kernel?)"; echo '{"ok":true,"builtin":true,"loaded":[],"failed":[]}' > "$STATE"; exit 0; }

depmod -a "$KVER" 2>/dev/null || log "depmod failed (non-fatal)"

# 1. explicit list from the adaptation package
LIST=/etc/lrd/modules-load.lrd
# 2. everything the kernel wanted but could not autoload, if the vendor left hints
HINTS=""
[ -r /vendor/lib/modules/modules.load ] && HINTS=/vendor/lib/modules/modules.load
[ -r /vendor/lib/modules/modules.load.recovery ] && HINTS="$HINTS /vendor/lib/modules/modules.load.recovery"

WANT=()
[ -f "$LIST" ] && while read -r m; do
  case "$m" in ''|\#*) continue ;; esac
  WANT+=("${m%.ko}")
done < "$LIST"

# if the adaptation listed nothing, take the vendor's own load list minus the
# Android-only modules that fight our userspace
if [ "${#WANT[@]}" -eq 0 ] && [ -n "$HINTS" ]; then
  skip='^(binder_linux|ashmem|android|binder)$'
  for h in $HINTS; do
    while read -r m; do
      case "$m" in ''|\#*) continue ;; esac
      m="${m%.ko}"
      printf '%s' "$m" | grep -qE "$skip" && continue
      WANT+=("$m")
    done < "$h"
  done
fi

loaded=(); failed=()
for m in "${WANT[@]:-}"; do
  [ -n "$m" ] || continue
  if lsmod 2>/dev/null | awk '{print $1}' | grep -qx "$m"; then loaded+=("$m"); continue; fi
  if modprobe "$m" 2>/dev/null; then loaded+=("$m")
  else failed+=("$m"); fi
done

# the ones we always want if they exist
for m in overlay fuse zram; do
  lsmod 2>/dev/null | awk '{print $1}' | grep -qx "$m" && continue
  modprobe "$m" 2>/dev/null && loaded+=("$m") || true
done

# persist the list so a reboot is deterministic
if [ "${#loaded[@]}" -gt 0 ]; then
  mkdir -p /etc/modules-load.d
  printf '%s\n' "${loaded[@]}" > /etc/modules-load.d/lrd-autoload.conf 2>/dev/null || true
fi

ok=1
[ "${#failed[@]}" -gt 0 ] && ok=0
jq -nc --argjson l "$(printf '%s\n' "${loaded[@]:-}" | jq -Rsc 'split("\n")|map(select(length>0))')" \
       --argjson f "$(printf '%s\n' "${failed[@]:-}" | jq -Rsc 'split("\n")|map(select(length>0))')" \
       --argjson ok "$ok" '{ok:($ok==1), loaded:$l, failed:$f}' > "$STATE"
log "loaded=${#loaded[@]} failed=${#failed[@]}"
[ "${#failed[@]}" -gt 0 ] && log "failed: ${failed[*]}"
exit 0
