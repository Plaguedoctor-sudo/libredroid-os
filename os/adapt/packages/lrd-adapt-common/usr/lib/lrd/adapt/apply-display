#!/usr/bin/env bash
# apply-display v2 — resolve the CURRENT variant to compositor env, and persist it.
# No fallback decisions here; lrd-cage-run owns advancing. This only renders env.
set -uo pipefail

CONF=/etc/lrd/display.conf
VARIANTS=/etc/lrd/display.variants
STATE=/run/lrd/display.state
CURRENT=/var/lib/lrd/display.variant
ATTEMPTS=/var/lib/lrd/display.attempts
mkdir -p /run/lrd /var/lib/lrd

log() { echo "[apply-display] $*"; logger -t lrd-adapt "$*" 2>/dev/null || true; }
fail() { log "FAIL: $*"; printf '{"ok":false,"reason":%s}\n' "$(printf '%s' "$*" | jq -Rs .)" > "$STATE"; exit 0; }

# --- what the kernel offers ---
cards=(); for c in /dev/dri/card*; do [ -e "$c" ] && cards+=("$c"); done
drm_ok=0; [ "${#cards[@]}" -gt 0 ] && drm_ok=1
connectors=(); for s in /sys/class/drm/card*-*; do
  [ -e "$s/status" ] || continue
  [ "$(cat "$s/status" 2>/dev/null)" = connected ] && connectors+=("$(basename "$s")")
done
hwc_path=""; for d in /vendor/lib64/hw /odm/lib64/hw /vendor/lib/hw; do
  for f in "$d"/hwcomposer.*.so "$d"/hwcomposer.so; do [ -e "$f" ] && { hwc_path="$f"; break 2; }; done
done
fb_ok=0; for f in /dev/fb* /dev/graphics/fb*; do [ -e "$f" ] && fb_ok=1; done

# --- candidate variants, filtered by feasibility ---
viable() {
  case "$1" in
    drm-*)  [ "$drm_ok" = 1 ] && [ "${#connectors[@]}" -gt 0 ] ;;
    hwc2-*) [ -n "$hwc_path" ] ;;
    fbdev)  [ "$fb_ok" = 1 ] ;;
    *) return 1 ;;
  esac
}

if [ -f "$VARIANTS" ]; then
  mapfile -t ALL < <(grep -vE '^\s*(#|$)' "$VARIANTS" | awk '{print $1}')
else
  ALL=(drm-atomic drm-legacy hwc2-egl hwc2-sw fbdev)
fi

FEASIBLE=(); for v in "${ALL[@]}"; do viable "$v" && FEASIBLE+=("$v"); done
[ "${#FEASIBLE[@]}" -eq 0 ] && fail "no feasible display variant (drm=$drm_ok hwc=$hwc_path fb=$fb_ok)"

# --- pick: explicit override > remembered winner > first feasible ---
VARIANT=""
if [ -f /run/lrd/display.force ]; then
  VARIANT="$(cat /run/lrd/display.force)"
elif [ -f "$CURRENT" ]; then
  VARIANT="$(cat "$CURRENT")"
  # a remembered variant that is no longer feasible falls back
  printf '%s\n' "${FEASIBLE[@]}" | grep -qx "$VARIANT" || { log "remembered '$VARIANT' no longer feasible"; VARIANT=""; }
fi
# deprioritise variants that failed recently
if [ -z "$VARIANT" ]; then
  for v in "${FEASIBLE[@]}"; do
    fails="$(awk -v k="$v" '$1==k{print $2}' "$ATTEMPTS" 2>/dev/null | tail -1)"
    [ "${fails:-0}" -lt 2 ] && { VARIANT="$v"; break; }
  done
  [ -z "$VARIANT" ] && VARIANT="${FEASIBLE[0]}"
fi

renderer=gles2; backend=drm
case "$VARIANT" in
  drm-atomic) renderer=gles2; backend=drm ;;
  drm-legacy) renderer=gles2; backend=drm ;;
  hwc2-egl)   renderer=gles2; backend=android ;;
  hwc2-sw)    renderer=pixman; backend=android ;;
  fbdev)      renderer=pixman; backend=fbdev ;;
esac

ENVF=/etc/environment.d/51-lrd-display.conf
{
  echo "# generated by lrd-adapt-common — variant $VARIANT"
  echo "LRD_DISPLAY_VARIANT=$VARIANT"
  echo "WLR_RENDERER=$renderer"
  case "$backend" in
    drm)
      echo "WLR_BACKENDS=drm"
      echo "WLR_DRM_DEVICES=$(IFS=:; echo "${cards[*]}")"
      [ "$VARIANT" = drm-legacy ] && echo "WLR_DRM_NO_ATOMIC=1"
      echo "WLR_NO_HARDWARE_CURSORS=1"
      ;;
    android)
      echo "WLR_BACKENDS=android"
      echo "LRD_HWCOMPOSER=$hwc_path"
      ;;
    fbdev)
      echo "WLR_BACKENDS=fbdev"
      ;;
  esac
  echo "XDG_SESSION_TYPE=wayland"
  echo "MOZ_ENABLE_WAYLAND=1"
  echo "QT_QPA_PLATFORM=wayland"
  echo "SDL_VIDEODRIVER=wayland"
} > "$ENVF"
set -a; . "$ENVF" 2>/dev/null; set +a

jq -nc --arg v "$VARIANT" --argjson drm "$drm_ok" --arg hwc "$hwc_path" \
  --argjson conn "$(printf '%s\n' "${connectors[@]:-}" | jq -Rsc 'split("\n")|map(select(length>0))')" \
  --argjson feas "$(printf '%s\n' "${FEASIBLE[@]}" | jq -Rsc 'split("\n")|map(select(length>0))')" \
  '{ok:true, variant:$v, feasible:$feas, drmAvailable:($drm==1), hwcomposer:$hwc, connected:$conn,
    degraded: ($v|test("^(fbdev|hwc2-sw)"))}' > "$STATE"

log "variant=$VARIANT feasible=${#FEASIBLE[@]} connectors=${#connectors[@]}"
exit 0
