#!/usr/bin/env bash
# apply-input — make the touchscreen behave like a libinput device, not a mouse.
set -uo pipefail
STATE=/run/lrd/input.state
mkdir -p /run/lrd /etc/libinput /etc/udev/rules.d
log() { echo "[apply-input] $*"; logger -t lrd-adapt "$*" 2>/dev/null || true; }

touch_devs=(); for d in /sys/class/input/event*; do
  [ -e "$d/device/name" ] || continue
  n="$(cat "$d/device/name" 2>/dev/null)"
  case "$n" in *touch*|*Touch*|*TP*|*ts_*|*gt9*|*goodix*|*focaltech*) touch_devs+=("$(basename "$d")");; esac
done

if [ "${#touch_devs[@]}" -eq 0 ]; then
  log "no touchscreen found in /sys/class/input"
  jq -nc '{ok:false, reason:"no touchscreen device", count:0}' > "$STATE"
  exit 0
fi

# libinput needs to know these are direct, absolute devices. The kernel usually says
# so; some vendor drivers need the hint.
mkdir -p /etc/udev/rules.d
cat > /etc/udev/rules.d/71-lrd-touch.rules <<'EOF'
# generated by lrd-adapt-common
ACTION=="add|change", KERNEL=="event*", ENV{ID_INPUT_TOUCHSCREEN}=="1", ENV{ID_INPUT}="1"
ACTION=="add|change", KERNEL=="event*", ATTRS{name}=="*touch*", ENV{ID_INPUT_TOUCHSCREEN}="1"
ACTION=="add|change", KERNEL=="event*", ATTRS{name}=="*Touch*", ENV{ID_INPUT_TOUCHSCREEN}="1"
EOF
udevadm control --reload-rules 2>/dev/null || true
udevadm trigger --subsystem-match=input 2>/dev/null || true

# on-screen keyboard for the shell when there is no hardware keyboard
cat > /etc/environment.d/53-lrd-input.conf <<'EOF'
# wlroots picks up touch as a direct device; cage needs the OSK to be a layer-shell client
LRD_TOUCH=1
WLR_LIBINPUT_NO_DEVICES=0
EOF

jq -nc --argjson n "${#touch_devs[@]}" --argjson devs "$(printf '%s\n' "${touch_devs[@]}" | jq -Rsc 'split("\n")|map(select(length>0))')" \
  '{ok:true, count:$n, devices:$devs}' > "$STATE"
log "touchscreen devices: ${#touch_devs[@]}"
exit 0
