#!/usr/bin/env bash
# apply-hybris — the load-bearing step.
#
# libhybris lets a glibc process dlopen bionic blobs. It needs three things:
#   1. the blob paths, via env
#   2. the ro.hardware.* Android properties, which name the default modules
#   3. the default module names to actually resolve
#
# (2) is the fragile one: no vendor init runs here, so the property area is empty.
# We try to set the properties, and if that fails we create compatibility symlinks
# so the compiled-in defaults resolve anyway. Either way we record which happened.
set -uo pipefail

CONF=/etc/lrd/hybris.conf
FACTS=/run/lrd/adapt.json
STATE=/run/lrd/hybris.state
mkdir -p /run/lrd

log() { echo "[apply-hybris] $*"; logger -t lrd-adapt "$*" 2>/dev/null || true; }

fail() {
  log "FAIL: $*"
  printf '{"ok":false,"reason":%s}\n' "$(printf '%s' "$*" | jq -Rs .)" > "$STATE"
  exit 0   # never block boot; validate reports it
}

[ -f "$CONF" ] || fail "no $CONF"
. "$CONF" 2>/dev/null || true

VENDOR="${VENDOR_PATH:-/vendor}"
ODM="${ODM_PATH:-/odm}"

# ---------- 1. the blobs must exist ----------
declare -A WANT=(
  [gralloc]="${GRALLOC_IMPL:-}"
  [egl]="${EGL_LIBS:-}"
  [hwcomposer]="${HWCOMPOSER_IMPL:-}"
  [audio]="${AUDIO_IMPL:-}"
  [ril]="${RIL_IMPL:-}"
  [sensors]="${SENSORS_IMPL:-}"
)
present="{}"; missing=()
for k in "${!WANT[@]}"; do
  v="${WANT[$k]}"
  if [ -z "$v" ]; then present=$(jq -c --arg k "$k" '. + {($k):"unset"}' <<<"$present"); continue; fi
  found=""
  for d in "$VENDOR/lib64/hw" "$VENDOR/lib64" "$ODM/lib64/hw" "$ODM/lib64" "$VENDOR/lib/hw" "$ODM/lib/hw"; do
    [ -e "$d/$v" ] && { found="$d/$v"; break; }
  done
  if [ -n "$found" ]; then
    present=$(jq -c --arg k "$k" --arg p "$found" '. + {($k):$p}' <<<"$present")
  else
    present=$(jq -c --arg k "$k" '. + {($k):null}' <<<"$present")
    missing+=("$k=$v")
  fi
done
[ "${#missing[@]}" -gt 0 ] && log "missing blobs: ${missing[*]}"

# ---------- 2. environment ----------
# libhybris reads these. Names follow upstream; both prefixed and bare forms are set
# because different forks look for different spellings.
ENVF=/etc/environment.d/50-lrd-hybris.conf
{
  echo "# generated by lrd-adapt-common — do not edit"
  echo "HYBRIS_LINKER=${HYBRIS_LINKER:-$VENDOR/bin/linker64}"
  echo "LINKER_NAMESPACE=${LINKER_NAMESPACE:-1}"
  echo "HYBRIS_EGL_PLATFORM=${EGL_PLATFORM:-default}"
  echo "EGL_PLATFORM=${EGL_PLATFORM:-default}"
  [ -n "${EGL_LIBS:-}" ] && { echo "HYBRIS_EGL=${EGL_LIBS}"; echo "HYBRIS_GLESV2=libGLESv2.so"; echo "HYBRIS_GLESV1=libGLESv1_CM.so"; }
  [ -n "${GRALLOC_IMPL:-}" ] && echo "HYBRIS_GRALLOC=${GRALLOC_IMPL}"
  [ -n "${HWCOMPOSER_IMPL:-}" ] && echo "HYBRIS_HWCOMPOSER=${HWCOMPOSER_IMPL}"
  [ -n "${AUDIO_IMPL:-}" ] && echo "HYBRIS_AUDIO=${AUDIO_IMPL}"
  [ -n "${RIL_IMPL:-}" ] && echo "HYBRIS_RIL=${RIL_IMPL}"
  echo "BINDER_DEVICE=${BINDER_DEVICE:-/dev/binderfs}"
  echo "ANDROID_ROOT=/system"
  echo "ANDROID_VENDOR=$VENDOR"
  echo "ANDROID_DATA=/data"
  echo "ANDROID_PROPERTY_WORKSPACE="
} > "$ENVF"

# also export for this process tree
set -a; . "$ENVF" 2>/dev/null; set +a

# ---------- 3. Android properties ----------
prop_set() { # key value -> 0 on success
  if command -v hybris-property-set >/dev/null 2>&1; then
    hybris-property-set "$1" "$2" 2>/dev/null && return 0
  fi
  if [ -x "$VENDOR/bin/setprop" ] && [ -x "$VENDOR/bin/linker64" ]; then
    "$VENDOR/bin/linker64" "$VENDOR/bin/setprop" "$1" "$2" 2>/dev/null && return 0
  fi
  return 1
}

props_ok=0; props_tried=0
setp() {
  props_tried=$((props_tried+1))
  [ -z "${2:-}" ] && return
  if prop_set "$1" "$2"; then props_ok=$((props_ok+1)); log "prop $1=$2"; fi
}

# the property space must exist before we assert anything about it
/usr/lib/lrd/adapt/propset /etc/lrd/device.props >/dev/null 2>&1 || true

setp ro.hardware.gralloc     "${GRALLOC_IMPL:-}"
setp ro.hardware.egl         "${EGL_PLATFORM:-}"
setp ro.hardware.hwcomposer  "${HWCOMPOSER_IMPL:-}"
setp ro.hardware.audio.primary "${AUDIO_IMPL:-}"
setp ro.hardware.sensors     "${SENSORS_IMPL:-}"
setp ro.hardware.lights      "${LIGHTS_IMPL:-}"
setp ro.hardware.power       "${POWER_IMPL:-}"
setp ro.hardware.vibrator    "${VIBRATOR_IMPL:-}"

if [ "$props_ok" -gt 0 ]; then props_mode=full
elif [ "$props_tried" -gt 0 ]; then props_mode=env-only
else props_mode=none; fi

# ---------- 4. the fallback that makes env-only survivable ----------
# libhybris falls back to a compiled-in default module name when the property is
# unreadable. Point the default names at the declared blobs so it resolves anyway.
linked=()
link_default() { # impl_dir default_name target
  local dir="$1" name="$2" target="$3"
  [ -z "$target" ] && return
  local tgt="$dir/$target"
  [ -e "$tgt" ] || return
  local dst="$dir/$name"
  [ -e "$dst" ] && [ ! -L "$dst" ] && return
  ln -sf "$target" "$dst" 2>/dev/null && linked+=("$name")
}

for hw in "$VENDOR/lib64/hw" "$ODM/lib64/hw"; do
  [ -d "$hw" ] || continue
  link_default "$hw" gralloc.default.so        "${GRALLOC_IMPL:-}"
  link_default "$hw" hwcomposer.default.so     "${HWCOMPOSER_IMPL:-}"
  link_default "$hw" audio.primary.default.so  "${AUDIO_IMPL:-}"
  link_default "$hw" sensors.default.so        "${SENSORS_IMPL:-}"
  link_default "$hw" lights.default.so         "${LIGHTS_IMPL:-}"
done

# ---------- 5. record ----------
ok=1
[ "${#missing[@]}" -gt 0 ] && ok=0
[ "$props_mode" = none ] && [ "${#linked[@]}" -eq 0 ] && ok=0

jq -nc \
  --argjson blobs "$present" \
  --arg props "$props_mode" \
  --argjson linked "$(printf '%s\n' "${linked[@]:-}" | jq -Rsc 'split("\n")|map(select(length>0))')" \
  --argjson ok "$ok" \
  --argjson missing "$(printf '%s\n' "${missing[@]:-}" | jq -Rsc 'split("\n")|map(select(length>0))')" \
  '{ok:($ok==1), blobs:$blobs, properties:$props, symlinked:$linked, missing:$missing,
    mode: (if $props=="full" then "property+env" elif ($linked|length)>0 then "env+shim" else "env-only" end)}' \
  > "$STATE"

log "mode=$(jq -r .mode "$STATE") blobs_ok=$(jq '[.blobs[]|select(.!=null)]|length' "$STATE") missing=${#missing[@]}"
exit 0
