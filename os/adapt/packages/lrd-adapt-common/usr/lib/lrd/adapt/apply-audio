#!/usr/bin/env bash
# apply-audio v2 — candidates from the vendor audio policy, winner proven empirically.
set -uo pipefail
STATE=/run/lrd/audio.state
WINNER=/var/lib/lrd/audio.winner
CACHE=/var/lib/lrd/audio.cache
mkdir -p /run/lrd /var/lib/lrd /etc/pulse
log() { echo "[apply-audio] $*"; logger -t lrd-adapt "$*" 2>/dev/null || true; }
fail() { log "FAIL: $*"; printf '{"ok":false,"reason":%s}\n' "$(printf '%s' "$*" | jq -Rs .)" > "$STATE"; exit 0; }

mod_present() { ls /usr/lib/pulse-*/modules/module-droid-card.so /usr/lib/pulse*/modules/module-droid-card.so >/dev/null 2>&1; }
mod_present || fail "module-droid-card not installed"

# ---------- 1. the HAL blob ----------
HAL=""
for d in /vendor/lib64/hw /odm/lib64/hw /vendor/lib/hw; do
  for f in "$d"/audio.primary.*.so "$d"/audio.primary.so; do [ -e "$f" ] && { HAL="$f"; break 2; }; done
done
[ -z "$HAL" ] && fail "no audio.primary HAL blob"
hal_suffix="$(basename "$HAL")"; hal_suffix="${hal_suffix#audio.primary.}"; hal_suffix="${hal_suffix%.so}"
[ "$hal_suffix" = "primary" ] && hal_suffix=""

# ---------- 2. the vendor's own policy: authoritative module + port names ----------
POLICY=""
for p in /vendor/etc/audio_policy_configuration.xml /odm/etc/audio_policy_configuration.xml \
         /vendor/etc/audio/audio_policy_configuration.xml /vendor/etc/audio_policy.conf; do
  [ -r "$p" ] && { POLICY="$p"; break; }
done

modules=(); ports=()
if [ -n "$POLICY" ]; then
  log "policy: $POLICY"
  case "$POLICY" in
    *.xml)
      mapfile -t modules < <(grep -oE '<module[^>]*name="[^"]+"' "$POLICY" | sed -E 's/.*name="([^"]+)".*/\1/' | sort -u)
      mapfile -t ports   < <(grep -oE '<(devicePort|mixPort)[^>]*name="[^"]+"' "$POLICY" | sed -E 's/.*name="([^"]+)".*/\1/' | sort -u | head -40)
      ;;
    *.conf)
      mapfile -t modules < <(sed -n 's/^[[:space:]]*\[\(.*\)\]/\1/p' "$POLICY" | sort -u)
      ;;
  esac
fi
[ "${#modules[@]}" -eq 0 ] && modules=(primary a2dp usb)

# ---------- 3. real ALSA cards, to filter impossible candidates ----------
alsa_cards=()
if [ -r /proc/asound/cards ]; then
  while read -r line; do
    id="$(sed -nE 's/^[[:space:]]*[0-9]+ \[([^ ]+)[[:space:]]*\].*/\1/p' <<<"$line")"
    [ -n "$id" ] && alsa_cards+=("$id")
  done < /proc/asound/cards
fi
log "policy modules: ${modules[*]:-none}  alsa cards: ${alsa_cards[*]:-none}"

# ---------- 4. build the candidate list ----------
# droid_card takes the HAL module name; card= takes the ALSA id when the HAL uses one.
cands=()
for m in "${modules[@]}"; do
  case "$m" in primary|a2dp|usb|r_submix|remote_submix|bluetooth) ;; *) continue ;; esac
  cands+=("$m|")
  for c in "${alsa_cards[@]}"; do cands+=("$m|$c"); done
  [ -n "$hal_suffix" ] && cands+=("$m|$hal_suffix")
done
# dedupe, keep order
mapfile -t cands < <(printf '%s\n' "${cands[@]}" | awk '!seen[$0]++')
log "${#cands[@]} candidates"

# ---------- 5. prove a candidate by loading it into a throwaway PA ----------
test_candidate() {
  local mod="$1" card="$2" sock=/run/lrd/pa-test.sock
  rm -f "$sock"
  cat > /run/lrd/pa-test.pa <<EOF
.fail
load-module module-native-protocol-unix socket=$sock
load-module module-droid-card card=${card:-$mod} droid_card=$mod rate=48000 hw_volume=1 primary_module=1
EOF
  timeout 10 pulseaudio --daemonize=no -n --file=/run/lrd/pa-test.pa \
    --exit-idle-time=60 -p /run/lrd/pa-test.pid >/run/lrd/pa-test.log 2>&1 &
  local pid=$!
  for _ in 1 2 3 4 5 6; do
    sleep 0.7
    if [ -S "$sock" ]; then
      local n; n="$(pactl --server="unix:$sock" list sinks short 2>/dev/null | wc -l)"
      if [ "${n:-0}" -gt 0 ]; then
        log "candidate OK: droid_card=$mod card=${card:-$mod} -> $n sink(s)"
        kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
        return 0
      fi
    fi
    kill -0 "$pid" 2>/dev/null || break
  done
  kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
  return 1
}

chosen_mod=""; chosen_card=""
# use the cache unless the policy or HAL changed
stamp="$(cat "$POLICY" 2>/dev/null | sha256sum | cut -c1-16)-$(stat -c %Y "$HAL" 2>/dev/null || echo 0)"
if [ -f "$CACHE" ] && [ "$(head -1 "$CACHE")" = "$stamp" ]; then
  chosen_mod="$(sed -n 2p "$CACHE")"; chosen_card="$(sed -n 3p "$CACHE")"
  log "cached winner: droid_card=$chosen_mod card=$chosen_card"
else
  for c in "${cands[@]}"; do
    m="${c%%|*}"; cd="${c##*|}"
    if test_candidate "$m" "$cd"; then chosen_mod="$m"; chosen_card="$cd"; break; fi
  done
  if [ -n "$chosen_mod" ]; then
    { echo "$stamp"; echo "$chosen_mod"; echo "$chosen_card"; } > "$CACHE"
  fi
fi

[ -z "$chosen_mod" ] && {
  # nothing proved out: still write a best-guess config so there is something to debug
  chosen_mod="${modules[0]:-primary}"; chosen_card=""
  log "no candidate proved — falling back to droid_card=$chosen_mod"
}

# ---------- 6. write the real config ----------
cat > /etc/pulse/droid-lrd.pa <<EOF
# generated by lrd-adapt-common — proven candidate
.ifexists module-droid-card.so
load-module module-droid-card card=${chosen_card:-$chosen_mod} droid_card=$chosen_mod \
  rate=48000 voicecall_auto_route=1 hw_volume=1 primary_module=1
.endif
.ifexists module-droid-sink.so
load-module module-droid-sink card=${chosen_card:-$chosen_mod} rate=48000
.endif
.ifexists module-droid-source.so
load-module module-droid-source card=${chosen_card:-$chosen_mod} rate=48000
.endif
EOF
grep -q 'droid-lrd.pa' /etc/pulse/default.pa 2>/dev/null || printf '\n.include /etc/pulse/droid-lrd.pa\n' >> /etc/pulse/default.pa

cat > /etc/environment.d/52-lrd-audio.conf <<EOF
LRD_AUDIO_HAL=$HAL
LRD_AUDIO_MODULE=$chosen_mod
LRD_AUDIO_CARD=$chosen_card
EOF

jq -nc --arg hal "$HAL" --arg m "$chosen_mod" --arg c "$chosen_card" \
  --argjson tried "${#cands[@]}" --argjson ok "$([ -n "$chosen_mod" ] && echo 1 || echo 0)" \
  --argjson policy "$(printf '%s' "$POLICY" | jq -Rs .)" \
  '{ok:($ok==1), hal:$hal, droid_card:$m, card:$c, candidates:$tried, policy:$policy,
    verified:($ok==1)}' > "$STATE"
log "droid_card=$chosen_mod card=${chosen_card:-none} verified=$([ -n "$chosen_mod" ] && echo yes || echo no)"
exit 0
