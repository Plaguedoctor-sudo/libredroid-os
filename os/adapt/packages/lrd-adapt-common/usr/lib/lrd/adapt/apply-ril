#!/usr/bin/env bash
# apply-ril — ofono against the vendor radio through libhybris.
set -uo pipefail
STATE=/run/lrd/ril.state
mkdir -p /run/lrd /etc/ofono
log() { echo "[apply-ril] $*"; logger -t lrd-adapt "$*" 2>/dev/null || true; }

# no modem (wifi-only tablet) is not a failure
modem_nodes="$(ls /dev/ 2>/dev/null | grep -cE '^(smd|qmi|rmnet|ttyUSB)' || true)"
if [ "${modem_nodes:-0}" -eq 0 ] && [ -z "$(getprop gsm.version.baseband 2>/dev/null)" ]; then
  log "no modem nodes — radio disabled"
  jq -nc '{ok:true, present:false, reason:"wifi-only device"}' > "$STATE"
  exit 0
fi

[ -x /usr/lib/ofono/ril-binder-plugin ] || [ -x /usr/sbin/ofonod ] || {
  jq -nc '{ok:false, present:true, reason:"ofono not installed"}' > "$STATE"; exit 0; }

slots="${RIL_SLOTS:-/dev/rmnet+}"
cat > /etc/ofono/ril_subscription.conf <<EOF
# generated by lrd-adapt-common
[ril_0]
name=$(echo "$slots" | cut -d, -f1)
driver=binder
slot=0
EOF

i=1
echo "$slots" | tr ',' '\n' | tail -n +2 | while read -r s; do
  [ -n "$s" ] || continue
  printf '\n[ril_%s]\nname=%s\ndriver=binder\nslot=%s\n' "$i" "$s" "$i" >> /etc/ofono/ril_subscription.conf
  i=$((i+1))
done

mkdir -p /etc/systemd/system/ofono.service.d
cat > /etc/systemd/system/ofono.service.d/10-lrd-ril.conf <<'EOF'
[Service]
EnvironmentFile=-/etc/environment.d/50-lrd-hybris.conf
Environment=OFONO_DRIVER=binder
EOF

jq -nc --arg s "$slots" --argjson ok 1 '{ok:true, present:true, slots:($s|split(","))}' > "$STATE"
log "slots=$slots"
exit 0
