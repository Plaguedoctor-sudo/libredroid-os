#!/usr/bin/env bash
# Slot-aware flashing. Android keeps the active slot; LibreDroid takes the other.
set -Eeuo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
BK="${LRD_BACKUP_DIR:-$HOME/lrd-backups}"
say(){ printf '\033[1;36m::\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die(){ printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

BOOT_IMG=""; ROOT_IMG=""; TARGET_SLOT=""; BACKUP_ONLY=0; YES=0
while [ $# -gt 0 ]; do case "$1" in
  --boot) BOOT_IMG="$2"; shift 2 ;;
  --root) ROOT_IMG="$2"; shift 2 ;;
  --slot) TARGET_SLOT="${2#_}"; shift 2 ;;
  --backup-only) BACKUP_ONLY=1; shift ;;
  --yes|-y) YES=1; shift ;;
  *) die "unknown $1" ;;
esac; done

fastboot getvar product >/dev/null 2>&1 || die "no device in fastboot"
product="$(fastboot getvar product 2>&1 | sed -n 's/^product: //p' | head -1)"
cur="$(fastboot getvar current-slot 2>&1 | sed -n 's/^current-slot: //p' | head -1)"
cur="${cur:-a}"
other=$([ "$cur" = a ] && echo b || echo a)
target="${TARGET_SLOT:-$other}"

say "device=$product  active slot=$cur  target slot=$target"
[ "$target" = "$cur" ] && warn "target IS the active slot — Android's slot $cur will be replaced"

# --- battery + unlock ---
locked="$(fastboot getvar unlocked 2>&1 | sed -n 's/^unlocked: //p' | head -1)"
[ "$locked" = "no" ] && die "bootloader locked — run: fastboot flashing unlock && fastboot flashing unlock_critical"

mkdir -p "$BK"
if [ "$BACKUP_ONLY" = 1 ] || [ ! -f "$BK/boot_${target}.img" ]; then
  say "backing up stock boot_$target, dtbo_$target, vbmeta_$target"
  for p in boot dtbo vbmeta; do
    fastboot fetch "${p}_${target}" "$BK/${p}_${target}.img" 2>/dev/null || \
      warn "could not fetch ${p}_${target} (fastboot fetch needs a recent bootloader)"
  done
  fastboot getvar all > "$BK/getvar-$(date +%s).txt" 2>&1 || true
  say "backups in $BK"
fi
[ "$BACKUP_ONLY" = 1 ] && exit 0

[ -n "$BOOT_IMG" ] && [ -f "$BOOT_IMG" ] || die "--boot <boot.img> required"
[ -n "$ROOT_IMG" ] && [ -f "$ROOT_IMG" ] || die "--root <rootfs.img> required"

sha_b="$(sha256sum "$BOOT_IMG" | cut -d' ' -f1)"
sha_r="$(sha256sum "$ROOT_IMG" | cut -d' ' -f1)"
say "boot  ${sha_b:0:16}…  $(du -h "$BOOT_IMG" | cut -f1)"
say "root  ${sha_r:0:16}…  $(du -h "$ROOT_IMG" | cut -f1)"

if [ "$YES" != 1 ]; then
  printf 'flash to slot %s? [y/N] ' "$target"; read -r a
  [ "$a" = y ] || exit 0
fi

# --- the rootfs may need a bigger logical partition than system_<slot> currently is ---
root_mb=$(( $(stat -c %s "$ROOT_IMG") / 1024 / 1024 ))
sys_mb="$(fastboot getvar "partition-size:system_${target}" 2>&1 | sed -n 's/.*: //p' | head -1)"

# Clean up any leftover snapshot COW partitions from incomplete OTAs to free super space
say "Checking and cleaning orphaned snapshot COW partitions in super..."
for cow in $(fastboot getvar all 2>&1 | grep -o '[a-zA-Z0-9_-]*-cow' | sort -u); do
  fastboot delete-logical-partition "$cow" 2>/dev/null || true
done

if [ -n "$sys_mb" ]; then
  sys_mb=$(( sys_mb / 1024 / 1024 ))
  say "system_$target is ${sys_mb}MB, rootfs needs ${root_mb}MB"
  if [ "$root_mb" -gt "$sys_mb" ]; then
    say "resizing logical partition (this destroys Android's slot $target)"
    fastboot delete-logical-partition "system_${target}" || warn "delete failed — not a dynamic device?"
    fastboot create-logical-partition "system_${target}" $(( root_mb + 256 )) || die "resize failed"
  fi
fi

say "writing"
fastboot flash "boot_${target}"   "$BOOT_IMG"                       || die "boot flash failed"
if [ -f "$BK/vbmeta_${target}.img" ]; then
  fastboot --disable-verity --disable-verification flash "vbmeta_${target}" "$BK/vbmeta_${target}.img" 2>/dev/null || \
    warn "could not patch stock vbmeta for slot $target"
fi
fastboot flash "system_${target}" "$ROOT_IMG"                       || die "rootfs flash failed"

# --- optional separate data partition for a persistent overlay ---
if [ -n "${LRD_DATA_IMG:-}" ] && [ -f "$LRD_DATA_IMG" ]; then
  say "writing lrddata_$target (persistent overlay)"
  fastboot delete-logical-partition "lrddata_${target}" 2>/dev/null || true
  fastboot create-logical-partition "lrddata_${target}" $(( $(stat -c %s "$LRD_DATA_IMG") / 1024 / 1024 + 64 )) || true
  fastboot flash "lrddata_${target}" "$LRD_DATA_IMG" || warn "lrddata flash failed — overlay will be tmpfs"
else
  warn "no lrddata image — the overlay will be tmpfs and every reboot is a factory reset"
fi

# On modern devices (MediaTek Helio G99), set_active only commits in fastbootd
is_userspace="$(fastboot getvar is-userspace 2>&1 | sed -n 's/^is-userspace: //p' | head -1)"
if [ "$is_userspace" != "yes" ]; then
  say "Switching to fastbootd to commit active slot to disk..."
  fastboot reboot fastboot 2>/dev/null || true
  while ! fastboot getvar is-userspace 2>&1 | grep -q 'yes'; do sleep 1; done
fi
fastboot set_active "$target" || warn "set_active failed — switch manually"
say "done. Android is in slot $cur, LibreDroid in slot $target."
say "boot LibreDroid now, or run: ./lrd-slot android to go back"
