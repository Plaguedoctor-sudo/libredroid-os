#!/usr/bin/env bash
# lrd-adapt — probe / blobs / gen / verify. Produces lrd-adapt-<vendor>-<codename>.
set -Eeuo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
OUT="${LRD_ADAPT_OUT:-$PWD/adapt-out}"
TPL="$HERE/templates"

say(){ printf '\033[1;36m::\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die(){ printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

cmd="${1:-probe}"; shift || true

case "$cmd" in

probe)
  command -v adb >/dev/null || die "adb missing"
  adb get-state >/dev/null 2>&1 || die "no device — enable USB debugging"
  mkdir -p "$OUT"
  say "probing $(adb shell getprop ro.product.model | tr -d '\r')"
  adb shell getprop > "$OUT/device.props.raw" 2>/dev/null || true
  bash "$HERE/lib/probe-device.sh" "$OUT" > "$OUT/device.probe.json"
  read -r level score nblock < <(bash "$HERE/lib/score.sh" "$OUT/device.probe.json" 2>"$OUT/score.log" || true)
  jq --arg l "$level" --argjson s "${score:-0}" '. + {supportLevel:$l, score:$s}' \
     "$OUT/device.probe.json" > "$OUT/device.json.tmp" && mv "$OUT/device.json.tmp" "$OUT/device.json"
  echo
  say "support level: $level   score: ${score:-0}/100   blockers: ${nblock:-0}"
  cat "$OUT/score.log" >&2 || true
  echo
  case "$level" in
    full)      say "flash it. this device is a real target." ;;
    partial)   warn "flash it, expect one broken subsystem (see blockers)" ;;
    boot-only) warn "it will boot to a console. display path is fragile." ;;
    unsupported) die "no display path — the kernel may be missing a panel driver" ;;
  esac
  ;;

blobs)
  [ -f "$OUT/device.json" ] || die "run 'probe' first"
  say "extracting vendor blobs"
  bash "$HERE/lib/extract-blobs.sh" "$OUT"
  ;;

gen)
  [ -f "$OUT/device.json" ] || die "run 'probe' first"
  say "generating adaptation package"
  bash "$HERE/lib/gen-package.sh" "$OUT" "$TPL"
  ;;

verify)
  [ -f "$OUT/lrd-adapt-"*/DEBIAN/control ] 2>/dev/null || die "run 'gen' first"
  say "validating package"
  pkgdir="$(ls -d "$OUT"/lrd-adapt-*/ 2>/dev/null | head -1)"
  [ -n "$pkgdir" ] || die "no package dir"
  chmod -R 0755 "$pkgdir/DEBIAN" 2>/dev/null || true
  for f in /etc/lrd/device.json /etc/lrd/display.conf /etc/lrd/hybris.conf; do
    [ -e "$pkgdir$f" ] || warn "missing $f"
  done
  dpkg-deb --build --root-owner-group "$pkgdir" "${pkgdir%/}.deb" >/dev/null && say "built ${pkgdir%/}.deb"
  dpkg-deb -I "${pkgdir%/}.deb" | head -20
  ;;

all) "$0" probe; "$0" blobs; "$0" gen; "$0" verify ;;

*) echo "usage: lrd-adapt {probe|blobs|gen|verify|all}"; exit 2 ;;
esac
