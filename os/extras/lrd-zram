#!/usr/bin/env bash
set -Eeuo pipefail
mem_mb=$(( $(awk '/MemTotal/{print $2}' /proc/meminfo) / 1024 ))
case "$mem_mb" in
  *[!0-9]*) mem_mb=2048 ;;
esac
if [ "$mem_mb" -lt 3000 ]; then
  pct=75; algo=zstd
elif [ "$mem_mb" -lt 6000 ]; then
  pct=50; algo=lz4
else
  pct=25; algo=lz4
fi
mkdir -p /etc/default 2>/dev/null || true
cat > /etc/default/zramswap <<EOF
ALGO=$algo
PERCENT=$pct
PRIORITY=100
EOF
systemctl enable --now zramswap.service 2>/dev/null || true
echo "zram: ${pct}% of ${mem_mb}MB, $algo"
# swap on zram is unencrypted in RAM; note it
