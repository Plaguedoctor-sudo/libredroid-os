#!/usr/bin/env bash
# lrd-a11y — accessibility, wired to things that exist.
set -Eeuo pipefail
say(){ printf '\033[1;36m::\033[0m %s\n' "$*"; }

case "${1:-status}" in
setup)
  apt-get install -y --no-install-recommends \
    at-spi2-core at-spi2-atk libatk-adaptor \
    speech-dispatcher speech-dispatcher-espeak-ng espeak-ng \
    orca \
    wl-mirror \
    gnome-themes-extra adwaita-icon-theme hicolor-icon-theme \
    fonts-noto-core fonts-noto-color-emoji 2>/dev/null || true
  # the toolkit bridges, set in the session; also here for X apps
  mkdir -p /etc/environment.d 2>/dev/null || true
  cat > /etc/environment.d/71-lrd-a11y.conf <<'EOF'
GTK_MODULES=gail:atk-bridge
QT_ACCESSIBILITY=1
NO_AT_BRIDGE=0
# a bigger default for touch
XCURSOR_SIZE=32
EOF
  # speech dispatcher
  mkdir -p /etc/speech-dispatcher 2>/dev/null || true
  cat > /etc/speech-dispatcher/speechd.conf <<'EOF'
DefaultRate 0
DefaultPitch 0
DefaultVolume 100
DefaultVoiceType 1
AddModule "espeak-ng" "sd_espeak-ng" "espeak-ng.conf"
DefaultModule espeak-ng
EOF
  say "accessibility stack installed"
  ;;

reader)
  case "${2:-toggle}" in
    on)
      [ -f /run/lrd/session.env ] && . /run/lrd/session.env 2>/dev/null || true
      systemctl --user start at-spi-dbus-bus 2>/dev/null || true
      speech-dispatcher --spawn 2>/dev/null || true
      pgrep -x orca >/dev/null || { orca --replace --no-setup >/dev/null 2>&1 & say "Orca started"; }
      ;;
    off) pkill -x orca 2>/dev/null || true; say "Orca stopped" ;;
    toggle) pgrep -x orca >/dev/null && "$0" reader off || "$0" reader on ;;
  esac
  ;;

contrast)
  case "${2:-on}" in
    on)
      mkdir -p /etc/environment.d 2>/dev/null || true
      echo 'GTK_THEME=HighContrast' > /etc/environment.d/72-lrd-contrast.conf
      gsettings set org.gnome.desktop.interface gtk-theme 'HighContrast' 2>/dev/null || true
      gsettings set org.gnome.desktop.interface icon-theme 'HighContrast' 2>/dev/null || true
      ;;
    off)
      mkdir -p /etc/environment.d 2>/dev/null || true
      echo 'GTK_THEME=Adwaita' > /etc/environment.d/72-lrd-contrast.conf
      gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita' 2>/dev/null || true
      ;;
  esac
  say "contrast $2 — restart the session to apply to new apps"
  ;;

scale)
  v="${2:-1.4}"
  gsettings set org.gnome.desktop.interface text-scaling-factor "$v" 2>/dev/null || true
  # the shell reads this through the bridge and applies its own scale token
  lrd-emit a11y "{\"scale\":$v}" 2>/dev/null || true
  say "text scale $v"
  ;;

magnifier)
  case "${2:-toggle}" in
    on)
      # two layers: the shell magnifies its own UI; wl-mirror covers native apps
      [ -f /run/lrd/session.env ] && . /run/lrd/session.env 2>/dev/null || true
      if command -v wl-mirror >/dev/null 2>&1; then
        pkill -x wl-mirror 2>/dev/null || true
        wl-mirror --scale "${3:-2}" >/dev/null 2>&1 &
        echo $! > /run/lrd/magnifier.pid
      fi
      lrd-emit a11y '{"magnifier":true}' 2>/dev/null || true
      say "magnifier on — Super+M toggles, drag to pan"
      ;;
    off)
      [ -f /run/lrd/magnifier.pid ] && kill "$(cat /run/lrd/magnifier.pid)" 2>/dev/null || true
      lrd-emit a11y '{"magnifier":false}' 2>/dev/null || true
      ;;
    toggle) [ -f /run/lrd/magnifier.pid ] && kill -0 "$(cat /run/lrd/magnifier.pid)" 2>/dev/null \
              && "$0" magnifier off || "$0" magnifier on ;;
  esac
  ;;

sticky)
  # libxkbcommon's AccessX support is partial; the reliable place is the OSK and
  # the shell's own keyboard, which is where touch users actually type.
  case "${2:-on}" in
    on)
      lrd-emit a11y '{"stickyKeys":true}' 2>/dev/null || true
      say "sticky keys on for the OSK and shell keyboard"
      ;;
    off) lrd-emit a11y '{"stickyKeys":false}' 2>/dev/null || true ;;
  esac
  ;;

keyboard-nav)
  # reveal focus rings everywhere, not just on pointer hover
  gsettings set org.gnome.desktop.interface gtk-key-theme 'Emacs' 2>/dev/null || true
  lrd-emit a11y '{"focusVisible":true}' 2>/dev/null || true
  say "focus rings always visible"
  ;;

status)
  echo "at-spi bus:  $(pgrep -f at-spi-bus-launcher >/dev/null && echo running || echo stopped)"
  echo "orca:        $(pgrep -x orca >/dev/null && echo running || echo stopped)"
  echo "speech:      $(pgrep -x speech-dispatcher >/dev/null && echo running || echo stopped)"
  echo "magnifier:   $([ -f /run/lrd/magnifier.pid ] && kill -0 "$(cat /run/lrd/magnifier.pid)" 2>/dev/null && echo running || echo off)"
  echo "text scale:  $(gsettings get org.gnome.desktop.interface text-scaling-factor 2>/dev/null || echo 1.0)"
  echo "gtk theme:   $(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null || echo unset)"
  echo "screen:      $(wlr-randr 2>/dev/null | grep -c 'current' || echo '?') output(s)"
  ;;

*) cat <<'EOF'
usage: lrd-a11y {setup|reader on|off|toggle|contrast|scale <n>|magnifier|sticky|keyboard-nav|status}
EOF
exit 2 ;;
esac
