# ==============================================================================
# LibreDroid OS - Project Treble Init Configuration
# Hooks into Vendor Hardware HAL (/vendor) & Snapdragon / MediaTek Kernel (/boot)
# ==============================================================================

on early-init
    # Initialize Binder IPC nodes for Vendor HAL communication
    # /dev/binder   -> Android Framework & LibreDroid Apps
    # /dev/hwbinder -> Hardware Services (Camera, Display, Audio, Fingerprint)
    # /dev/vndbinder-> Vendor RIL Modem (VoLTE, Cellular Data)
    mkdir /dev/binderfs 0755 root root
    mount binder binder /dev/binderfs
    chmod 0666 /dev/binderfs/binder
    chmod 0666 /dev/binderfs/hwbinder
    chmod 0666 /dev/binderfs/vndbinder

on init
    # Bind mounts for Vendor Hardware HAL
    export ANDROID_VENDOR_KEYS /vendor/etc/security/otacerts.zip
    export VENDOR_MOUNT_POINT /vendor

    # Camera HAL3 / GCam Tuning
    setprop persist.camera.HAL3.enabled 1
    setprop persist.sys.camera.camera2 1
    setprop ro.camera.enable_camera2 1

    # VoLTE & Cellular IMS Calling
    setprop persist.dbg.volte_avail_ovr 1
    setprop persist.dbg.vt_avail_ovr 1
    setprop persist.dbg.wfc_avail_ovr 1
    setprop persist.sys.phh.volte.enabled 1

    # Widevine L1 DRM OEMCrypto Path
    setprop drm.service.enabled true
    setprop media.mediadrmservice.enable true

    # Play Integrity & Bootloader Cloaking
    setprop ro.boot.flash.locked 1
    setprop ro.boot.verifiedbootstate green
    setprop ro.boot.veritymode enforcing

on post-fs-data
    # Create LibreDroid runtime directories
    mkdir /data/libredroid 0770 system system
    mkdir /data/libredroid/shell 0770 system system
    mkdir /data/libredroid/microg 0770 system system

    # Start Hardware Bridge Service connecting to /vendor HALs
    start libredroid-hal-bridge

service libredroid-hal-bridge /system/bin/libredroid-bridge
    class main
    user root
    group system audio camera graphics inet net_bt net_bt_admin
    capabilities NET_ADMIN SYS_ADMIN
    seclabel u:r:init:s0
