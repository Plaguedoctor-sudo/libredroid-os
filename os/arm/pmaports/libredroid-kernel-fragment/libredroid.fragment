# ── Waydroid ──
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ASHMEM=y
CONFIG_MEMFD_CREATE=y

# ── namespaces (the whole isolation story) ──
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y

# ── cgroup v2 ──
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_PSI=y

# ── seccomp + LSMs ──
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,apparmor,bpf"

# ── netfilter: the Tor gateway depends on all of these ──
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIRECT=y
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MATCH_CGROUP=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_NET_SCHED=y

# ── storage / fs ──
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_SQUASHFS=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_FUSE_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_ZRAM=y
CONFIG_ZSWAP=y

# ── GPU: mainline only. Waydroid renders through gbm. ──
CONFIG_DRM=y
CONFIG_DRM_FREEDRENO=y     # Qualcomm Adreno
CONFIG_DRM_PANFROST=y      # Mali Bifrost/Valhall
CONFIG_DRM_PANTHOR=y       # Mali CSF (G310/G510/G610/G710)
CONFIG_DRM_LIMA=y
CONFIG_DRM_MSM=y

# ── hardware the shell expects ──
CONFIG_IIO=y
CONFIG_IIO_ST_ACCEL_3AXIS=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_SND_USB_AUDIO=y
CONFIG_BINFMT_MISC=y
