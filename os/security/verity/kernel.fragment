# Forward error correction + fail-closed on corruption.
# Without these, a single bad block is an I/O error the fs may paper over.
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG_SECONDARY_KEYRING=y
CONFIG_DM_BUFIO=y
CONFIG_CRYPTO_SHA256=y
