#!/usr/bin/env bash
# lrd-tcb-manifest — enumerate, seal (fs-verity) and sign the files whose integrity
# matters. The manifest is the anchor for the writable layer.
#   list | seal [--all] | sign | verify [--strict] | unseal <path> | diff
set -Eeuo pipefail
STORE="${LRD_STORE:-/store}"
OUT="${LRD_TCB_OUT:-$STORE/security}"
KEYS="${LRD_VERITY_KEYS:-/etc/lrd/keys}"
MANIFEST="$OUT/tcb-manifest.jsonl"
say(){ printf '\033[1;36m::\033[0m %s\n' "$*"; }
die(){ printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run as root"

# ---------- the TCB set ----------
# Everything here, if changed, changes what the OS *is*. Not user data.
PATHS=(
  /opt/lrd/app/server.js
  /opt/lrd/app/dist
  /opt/lrd/app/os
  /opt/lrd/app/launch.sh
  /usr/lib/lrd
  /usr/sbin/lrd-adapt-apply /usr/sbin/lrd-bootcount /usr/sbin/lrd-slot
  /usr/sbin/lrd-user /usr/sbin/lrd-update /usr/sbin/lrd-verity
  /usr/bin/lrd-adapt-report /usr/bin/lrd-adapt-txn /usr/bin/lrd-adapt-diff
  /usr/bin/lrd-security-audit /usr/bin/lrd-tcb-manifest
  /usr/bin/lrd-netd /usr/bin/lrd-powerd /usr/bin/lrd-qa /usr/bin/lrd-report
  /etc/sudoers
  /etc/sudoers.d
  /etc/pam.d
  /etc/ssh/sshd_config
  /etc/greetd/config.toml
  /etc/lrd/keys
  /etc/nftables.d
  /etc/systemd/system/lrd-adapt-apply.service
  /etc/systemd/system/lrd-adapt-late.service
  /etc/systemd/system/lrd-adapt-validate.service
  /etc/systemd/system/lrd-bootgate.service
  /etc/systemd/system/lrd-bootcount-mark.service
  /etc/systemd/system/lrd-props.service
  /etc/systemd/system/lrd-tcb-verify.service
  /etc/systemd/system/lrd-security-audit.service
  /etc/systemd/system/lrd-harden.service
  /etc/systemd/system/lrd-bridge.service
  /etc/systemd/system/cage.service
  /etc/systemd/system/cage.service.d
  /etc/systemd/system/lrd-safe.target
  /etc/systemd/system/lrd-safe-console.service
)

enumerate() {
  for p in "${PATHS[@]}"; do
    [ -e "$p" ] || continue
    if [ -d "$p" ]; then
      find "$p" -type f -o -type l 2>/dev/null
    else
      printf '%s\n' "$p"
    fi
  done | sort -u
}

hash_of() {
  local f="$1"
  # prefer the fs-verity digest: O(1), no read, and it is kernel-enforced on read
  if command -v fsverity >/dev/null 2>&1; then
    local d; d="$(fsverity measure "$f" 2>/dev/null | awk '{print $1}')"
    [ -n "$d" ] && { echo "fsverity:$d"; return; }
  fi
  echo "sha256:$(sha256sum "$f" 2>/dev/null | cut -d' ' -f1)"
}

case "${1:-verify}" in

list)
  enumerate
  ;;

seal)
  all=0; [ "${2:-}" = --all ] && all=1
  command -v fsverity >/dev/null || die "fsverity tool missing (apt install fsverity)"
  # the overlay fs must carry the verity feature
  if ! tune2fs -l "$(findmnt -no SOURCE /overlay 2>/dev/null)" 2>/dev/null | grep -q 'verity'; then
    say "WARNING: the overlay filesystem has no verity feature — run mkfs with -O verity"
    say "         falling back to content hashing for everything"
  fi
  mkdir -p "$OUT"
  : > "$MANIFEST.new"
  sealed=0; failed=0
  while read -r f; do
    [ -f "$f" ] || { [ -L "$f" ] || continue; }
    # only files on the writable layer can be sealed
    case "$(findmnt -no TARGET -T "$f" 2>/dev/null)" in
      /overlay*|/|/etc|/usr|/opt|/home|/var) ;;
      *) : ;;
    esac
    if [ "$all" = 1 ]; then
      fsverity enable "$f" 2>/dev/null && sealed=$((sealed+1)) || failed=$((failed+1))
    fi
    h="$(hash_of "$f")"
    meta="$(stat -c '%a %u %g %s' "$f" 2>/dev/null)"
    printf '{"path":%s,"digest":%s,"mode":%s,"uid":%s,"gid":%s,"size":%s,"type":%s}\n' \
      "$(printf '%s' "$f" | jq -Rs .)" "$(printf '%s' "$h" | jq -Rs .)" \
      "$(echo "$meta" | awk '{print $1}')" "$(echo "$meta" | awk '{print $2}')" \
      "$(echo "$meta" | awk '{print $3}')" "$(echo "$meta" | awk '{print $4}')" \
      "$([ -L "$f" ] && echo symlink || echo file)" >> "$MANIFEST.new"
  done < <(enumerate)

  jq -s --arg at "$(date -Is)" --arg ver "$(sed -n 's/^VERSION_ID="\(.*\)"/\1/p' /etc/os-release 2>/dev/null || echo "2026.10")" \
    '{generatedAt:$at, version:$ver, count:length, entries:.}' "$MANIFEST.new" > "$OUT/tcb-manifest.json"
  mv "$MANIFEST.new" "$MANIFEST"
  say "manifest: $(jq -r .count "$OUT/tcb-manifest.json") entries, $sealed sealed, $failed unsealed"
  ;;

sign)
  [ -f "$OUT/tcb-manifest.json" ] || die "run seal first"
  openssl dgst -sha256 -sign "$KEYS/verity.key.pem" -out "$OUT/tcb-manifest.json.sig" "$OUT/tcb-manifest.json"
  say "signed"
  # also embed a digest of the manifest in the store so a missing manifest is visible
  sha256sum "$OUT/tcb-manifest.json" > "$OUT/tcb-manifest.sha256"
  ;;

unseal)
  f="${2:?path}"
  fsverity disable "$f" 2>/dev/null || true
  say "unsealed $f — write, then re-run 'seal' and 'sign'"
  ;;

verify)
  strict=0; [ "${2:-}" = --strict ] && strict=1
  [ -f "$OUT/tcb-manifest.json" ] || die "no manifest"
  openssl dgst -sha256 -verify "$KEYS/verity.pub.pem" \
    -signature "$OUT/tcb-manifest.json.sig" "$OUT/tcb-manifest.json" \
    || die "MANIFEST SIGNATURE INVALID"

  bad=0; missing=0; ok=0; changed=()
  while read -r e; do
    f="$(jq -r .path <<<"$e")"; want="$(jq -r .digest <<<"$e")"
    if [ ! -e "$f" ]; then missing=$((missing+1)); changed+=("MISSING $f"); continue; fi
    got="$(hash_of "$f")"
    if [ "$got" = "$want" ]; then ok=$((ok+1)); else bad=$((bad+1)); changed+=("CHANGED $f"); fi
  done < <(jq -c '.entries[]' "$OUT/tcb-manifest.json")

  jq -nc --argjson ok "$ok" --argjson bad "$bad" --argjson missing "$missing" \
    --argjson changed "$(printf '%s\n' "${changed[@]:-}" | jq -Rsc 'split("\n")|map(select(length>0))')" \
    --arg at "$(date -Is)" \
    '{verified:($bad==0 and $missing==0), ok:$ok, changed:$bad, missing:$missing, detail:$changed, at:$at}' \
    > /run/lrd/tcb.json

  printf '  ok %s  changed %s  missing %s\n' "$ok" "$bad" "$missing"
  if [ "$bad" -gt 0 ] || [ "$missing" -gt 0 ]; then
    for c in "${changed[@]}"; do printf '    %s\n' "$c"; done
    [ "$strict" = 1 ] && exit 1
  fi
  ;;

diff)
  [ -f "$OUT/tcb-manifest.json" ] || die "no manifest"
  "$0" verify 2>&1 | grep -E 'CHANGED|MISSING' || echo "  clean"
  ;;

*) echo "usage: lrd-tcb-manifest {list|seal [--all]|sign|verify [--strict]|unseal <path>|diff}"; exit 2 ;;
esac
