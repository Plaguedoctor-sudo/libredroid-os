#!/usr/bin/env bash
# lrd-verity-tool — dm-verity formatting, signing, and verification engine.
# Provides cryptographic authenticity and integrity verification for the LibreDroid rootfs.
set -Eeuo pipefail

KEY="${LRD_SIGN_KEY:-}"
PUBKEY="${LRD_VERITY_PUBKEY:-/etc/lrd/verity-release.pub}"
say(){ printf '\033[1;36m::\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die(){ printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

cmd="${1:-status}"; shift || true

case "$cmd" in
  format)
    # Usage: lrd-verity-tool format <rootfs.raw> <hash_table.img> [out_meta.json]
    ROOTFS="${1:?usage: lrd-verity-tool format <rootfs.raw> <hash_table.img> [out_meta.json]}"
    HASHTBL="${2:?hash_table.img}"
    META="${3:-${ROOTFS}.verity.json}"
    
    command -v veritysetup >/dev/null 2>&1 || die "veritysetup binary not found (install cryptsetup-bin)"
    [ -f "$ROOTFS" ] || die "rootfs $ROOTFS not found"
    
    say "formatting dm-verity hash tree for $ROOTFS..."
    V_OUT="$(veritysetup format "$ROOTFS" "$HASHTBL")"
    
    ROOTHASH="$(echo "$V_OUT" | awk -F: '/Root hash:/{gsub(/[ \t]/,"",$2); print $2}')"
    SALT="$(echo "$V_OUT" | awk -F: '/Salt:/{gsub(/[ \t]/,"",$2); print $2}')"
    BLOCK_SZ="$(echo "$V_OUT" | awk -F: '/Data block size:/{gsub(/[ \t]/,"",$2); print $2}')"
    HASH_SZ="$(echo "$V_OUT" | awk -F: '/Hash block size:/{gsub(/[ \t]/,"",$2); print $2}')"
    
    [ -n "$ROOTHASH" ] || die "failed to extract root hash"
    
    cat > "$META" <<EOF
{
  "rootfs": "$(basename "$ROOTFS")",
  "roothash": "$ROOTHASH",
  "salt": "$SALT",
  "dataBlockSize": ${BLOCK_SZ:-4096},
  "hashBlockSize": ${HASH_SZ:-4096},
  "formattedAt": "$(date -Is)",
  "rootfsSha256": "$(sha256sum "$ROOTFS" | cut -d' ' -f1)"
}
EOF
    echo "$ROOTHASH" > "${ROOTFS}.roothash"
    say "dm-verity hash tree generated."
    say "Root Hash: $ROOTHASH"
    say "Metadata saved to $META"
    ;;

  sign)
    # Usage: lrd-verity-tool sign <meta.json|rootfs.roothash>
    TARGET="${1:?usage: lrd-verity-tool sign <file>}"
    [ -f "$TARGET" ] || die "$TARGET not found"
    [ -n "$KEY" ] || warn "LRD_SIGN_KEY not set; using default GPG key"
    
    say "signing dm-verity root hash artifact $TARGET..."
    gpg --batch --yes --armor --detach-sign ${KEY:+--local-user "$KEY"} "$TARGET"
    say "created signature: ${TARGET}.asc"
    ;;

  open)
    # Usage: lrd-verity-tool open <rootfs.raw> <hash_table.img> <roothash> [device_mapper_name]
    ROOTFS="${1:?rootfs.raw}"
    HASHTBL="${2:?hash_table.img}"
    ROOTHASH="${3:?roothash}"
    MAPPER_NAME="${4:-lrd-verity-root}"
    
    command -v veritysetup >/dev/null 2>&1 || die "veritysetup not found"
    say "attaching dm-verity device /dev/mapper/$MAPPER_NAME..."
    veritysetup open "$ROOTFS" "$MAPPER_NAME" "$HASHTBL" "$ROOTHASH"
    say "device /dev/mapper/$MAPPER_NAME is active and verified."
    ;;

  close)
    MAPPER_NAME="${1:-lrd-verity-root}"
    say "closing /dev/mapper/$MAPPER_NAME..."
    veritysetup close "$MAPPER_NAME" 2>/dev/null || true
    ;;

  status)
    MAPPER_NAME="${1:-lrd-verity-root}"
    if [ -e "/dev/mapper/$MAPPER_NAME" ]; then
      veritysetup status "$MAPPER_NAME" 2>/dev/null || echo "Active (device mapper)"
      echo "state=enforced"
    else
      echo "dm-verity is not active (/dev/mapper/$MAPPER_NAME does not exist)"
      echo "state=disabled"
    fi
    ;;

  *)
    echo "usage: lrd-verity-tool {format|sign|open|close|status} [args...]"
    exit 2
    ;;
esac
