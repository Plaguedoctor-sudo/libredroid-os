#!/usr/bin/env bash
# lrd-boot-integrity — probe what the bootloader can actually give us, and bind the
# slots to each other so an inconsistent rollback is detectable.
#   probe | bind | check | matrix
set -uo pipefail
STORE="${LRD_STORE:-/store}"
say(){ printf '\033[1;36m::\033[0m %s\n' "$*"; }

cmdval(){ sed -n "s/.*$1=\([^ ]*\).*/\1/p" /proc/cmdline | head -1; }

case "${1:-probe}" in
probe)
  locked="$(cmdval androidboot.flash.locked)"
  vbstate="$(cmdval androidboot.verifiedbootstate)"
  # x86: UEFI Secure Boot
  sb="unknown"
  [ -d /sys/firmware/efi ] && {
    if command -v mokutil >/dev/null 2>&1; then sb="$(mokutil --sb-state 2>/dev/null | grep -qi enabled && echo enabled || echo disabled)"
    else
      for v in /sys/firmware/efi/efivars/SecureBoot-*; do
        [ -e "$v" ] && sb="$(od -An -tu1 -j4 -N1 "$v" 2>/dev/null | tr -d ' ' | sed 's/^1$/enabled/;s/^0$/disabled/')"
      done
    fi
  }

  # avb_custom_key: the partition is the signal, and some bootloaders accept a flash
  # even where they ignore it, so probe both
  avbkey=absent
  [ -e /dev/block/by-name/avb_custom_key ] && avbkey=present
  grep -q 'avb_custom_key' /proc/cmdline 2>/dev/null && avbkey=present

  level=0
  [ "$locked" = "1" ] && level=1
  [ "$avbkey" = present ] && [ "$locked" = "1" ] && level=2
  [ "$vbstate" = green ] && level=3
  [ "$sb" = enabled ] && level=4

  case "$level" in
    4) verdict="full-chain (UEFI Secure Boot)" ;;
    3) verdict="full-chain (AVB green, relocked)" ;;
    2) verdict="avb-key-present-but-unlocked" ;;
    1) verdict="bootloader-locked-no-custom-key" ;;
    *) verdict="unlocked — Tier 2 only" ;;
  esac

  mkdir -p /run/lrd
  jq -nc --argjson level "$level" --arg v "$verdict" --arg locked "${locked:-unknown}" \
    --arg vb "${vbstate:-unknown}" --arg sb "$sb" --arg avbkey "$avbkey" \
    --argjson customkey "$([ "$avbkey" = present ] && echo true || echo false)" \
    '{level:$level, verdict:$v, flashLocked:$locked, verifiedBoot:$vb,
      secureBoot:$sb, avbCustomKey:$customkey,
      note: (if $level >= 3 then "the bootloader verifies boot.img, so the initramfs and its key are trusted"
             elif $level == 1 then "locked but no custom key: the OEM key cannot sign our vbmeta, so verification is off"
             else "unlocked: an attacker with fastboot can replace everything. Tier 2 still catches corruption." end)}' \
    > /run/lrd/boot-integrity.json

  echo "level:  $level/4"
  echo "state:  $verdict"
  echo "locked: ${locked:-unknown}   verifiedboot: ${vbstate:-unknown}   secureboot: $sb   avb_custom_key: $avbkey"
  ;;

bind)
  # record each slot's boot image hash in the OTHER slot's signed metadata, so an
  # attacker rolling one slot back must keep the pair consistent
  for s in a b; do
    o=$([ "$s" = a ] && echo b || echo a)
    img="$STORE/lrd-boot_${o}.img"
    [ -f "$img" ] || continue
    h="$(sha256sum "$img" | cut -d' ' -f1)"
    meta="$STORE/verity/lrd-verity_${s}.json"
    [ -f "$meta" ] || continue
    jq --arg o "$o" --arg h "$h" '.peerSlot=$o | .peerBootSha256=$h' "$meta" > "$meta.t" && mv "$meta.t" "$meta"
    openssl dgst -sha256 -sign /etc/lrd/keys/verity.key.pem -out "$meta.sig" "$meta"
    say "slot $s metadata now binds slot $o boot image ${h:0:16}…"
  done
  ;;

check)
  bad=0
  for s in a b; do
    meta="$STORE/verity/lrd-verity_${s}.json"
    [ -f "$meta" ] || continue
    o="$(jq -r '.peerSlot // empty' "$meta")"
    want="$(jq -r '.peerBootSha256 // empty' "$meta")"
    [ -n "$o" ] && [ -n "$want" ] || continue
    img="$STORE/lrd-boot_${o}.img"
    [ -f "$img" ] || { say "slot $s expects a boot image for slot $o — not present"; bad=$((bad+1)); continue; }
    got="$(sha256sum "$img" | cut -d' ' -f1)"
    if [ "$got" != "$want" ]; then
      say "INCONSISTENT: slot $o boot image does not match slot $s metadata"
      bad=$((bad+1))
    fi
  done
  [ "$bad" = 0 ] && say "slot pairing consistent" || say "$bad inconsistency(ies)"
  exit 0
  ;;

matrix)
  cat <<'EOF'
device capability matrix — what to expect

  device                      locked  avb_custom_key  expected level
  Pixel 6+                    yes     yes             full-chain
  OnePlus 6/6T (SDM845)       yes*    yes             full-chain
  OnePlus 8/9/10              yes*    sometimes       level 1-2
  OnePlus Pad (MT6983)        yes*    unlikely        level 1 (Tier 2 only)
  Xiaomi/Redmi (MTK)          yes*    rarely          level 0-1
  most MediaTek               yes*    no              level 0-1
  x86_64 + our own UEFI keys  n/a     n/a             full-chain

  * locked only if you relock, and relocking without a working avb_custom_key
    makes the device unbootable. Order: flash avb_custom_key FIRST, verify it
    took, THEN lock. Never lock on a device where the custom key partition does
    not exist.
EOF
  ;;
*) echo "usage: lrd-boot-integrity {probe|bind|check|matrix}"; exit 2 ;;
esac
