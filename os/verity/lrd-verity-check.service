[Unit]
Description=LibreDroid — re-verify the rootfs at boot
DefaultDependencies=no
After=sysinit.target
Before=cage.service lrdd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/lrd /run/libredroid /var/lib/lrd
ExecStart=/usr/bin/lrd-verity-check
SuccessExitStatus=0 1

[Install]
WantedBy=sysinit.target
