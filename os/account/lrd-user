#!/usr/bin/env bash
# lrd-user — create / passwd / lock / list. Wraps useradd with the groups and
# PAM bits a desktop needs, and can set autologin for a kiosk.
set -Eeuo pipefail
GROUPS="audio,video,render,input,plugdev,netdev,bluetooth"
die(){ echo "xx $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run as root"

cmd="${1:-list}"; shift || true
case "$cmd" in
create)
  u="${1:?username}"; shift || true
  admin=0; autologin=0; shell=/bin/bash; password=""
  while [ $# -gt 0 ]; do case "$1" in
    --admin) admin=1; shift ;;
    --autologin) autologin=1; shift ;;
    --shell) shell="$2"; shift 2 ;;
    --password) password="$2"; shift 2 ;;
    *) shift ;;
  esac; done
  id "$u" >/dev/null 2>&1 || useradd -m -s "$shell" -G "$GROUPS" "$u"
  [ "$admin" = 1 ] && { groupadd -f sudo; usermod -aG sudo "$u"; }
  mkdir -p /home/"$u"/.lrd
  chown -R "$u":"$u" /home/"$u"/.lrd
  if [ -n "$password" ]; then printf '%s:%s\n' "$u" "$password" | chpasswd; fi
  if [ "$autologin" = 1 ]; then
    mkdir -p /etc/greetd
    cat > /etc/greetd/config.toml <<EOF
[terminal]
vt = 1
[default_session]
command = "tuigreet --time --remember --remember-session --cmd 'cage -s -- /opt/lrd/app/launch.sh'"
user = "$u"
EOF
    systemctl enable greetd.service 2>/dev/null || true
    echo "autologin enabled for $u"
  fi
  echo "created $u"
  ;;
passwd)
  u="${1:?username}"; shift || true
  [ "$1" = --password ] && { printf '%s:%s\n' "$u" "$2" | chpasswd; echo "set"; exit 0; }
  passwd "$u"
  ;;
lock)   usermod -L "${1:?username}"; echo "locked $1" ;;
unlock) usermod -U "${1:?username}"; echo "unlocked $1" ;;
delete)
  u="${1:?username}"
  [ "$u" = root ] && die "not root"
  loginctl terminate-user "$u" 2>/dev/null || true
  userdel -r "$u" 2>/dev/null || userdel "$u"
  echo "deleted $u"
  ;;
list)
  awk -F: '$3>=1000 && $3<65534 {printf "%-16s uid=%s shell=%s\n",$1,$3,$7}' /etc/passwd
  ;;
who)
  loginctl list-sessions --no-legend 2>/dev/null || true
  ;;
*) echo "usage: lrd-user {create|passwd|lock|unlock|delete|list|who}"; exit 2 ;;
esac
