[Unit]
Description=LibreDroid update check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c "/usr/bin/lrd-update check 2>/dev/null || true"
ExecStartPost=-/bin/sh -c 'v=$$(ls -1 /lrdstore/updates/lrd-update_*.json 2>/dev/null | sort -V | tail -1 | sed "s/.*lrd-update_//;s/.json//"); c=$$(sed -n "s/^VERSION_ID=\"\\(.*\\)\"/\\1/p" /etc/os-release); [ -n "$$v" ] && [ "$$v" != "$$c" ] && /usr/local/bin/lrd-emit lifecycle "{\\"updateAvailable\\":\\"$$v\\"}" || true'

[Install]
WantedBy=multi-user.target
