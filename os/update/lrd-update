#!/usr/bin/env bash
# lrd-update — check / download / stage / apply / rollback.
# apply() writes to the INACTIVE slot and arms it. A bad update is reverted by the
# bootloader, without userspace cooperation.
set -Eeuo pipefail
VER=/etc/lrd/update.conf
STORE=/lrdstore
SRC="${LRD_UPDATE_SRC:-file:///lrdstore/updates}"
KEYRING=/usr/share/lrd/keys/update.gpg
BC=/usr/sbin/lrd-bootcount

say(){ printf '\033[1;36m::\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die(){ printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

cur_slot(){ sed -n 's/.*androidboot.slot_suffix=\([^ ]*\).*/\1/p' /proc/cmdline | sed 's/^_//'; }
other_slot(){ [ "$(cur_slot)" = a ] && echo b || echo a; }

need_root() { [ "$(id -u)" = 0 ] || die "run as root"; }
mount_store() { mkdir -p "$STORE"; mountpoint -q "$STORE" || mount /dev/disk/by-label/LRDSTORE "$STORE" || die "cannot mount LRDSTORE"; }

case "${1:-check}" in

check)
  mount_store
  latest="$(ls -1 "$STORE"/updates/lrd-update_*.json 2>/dev/null | sort -V | tail -1)"
  [ -n "$latest" ] || die "no update sets in $STORE/updates"
  ver="$(basename "$latest" .json | sed 's/^lrd-update_//')"
  if [ -f "$KEYRING" ]; then
    gpg --no-default-keyring --keyring "$KEYRING" --verify "$latest.asc" "$latest" 2>/dev/null \
      || die "manifest signature INVALID"
    say "signature ok"
  else warn "no keyring at $KEYRING — signatures unverified"; fi
  jq . "$latest"
  echo
  say "current $(cat /etc/os-release | sed -n 's/^VERSION_ID="\(.*\)"/\1/p')  available $ver"
  ;;

download)
  mount_store
  latest="$(ls -1 "$STORE"/updates/lrd-update_*.json 2>/dev/null | sort -V | tail -1)"
  ver="$(basename "$latest" .json | sed 's/^lrd-update_//')"
  if [ -n "${LRD_UPDATE_URL:-}" ]; then
    say "fetching $ver from $LRD_UPDATE_URL"
    for f in "lrd-rootfs_${ver}.raw" "lrd-rootfs_${ver}.raw.sha256" "lrd-rootfs_${ver}.raw.asc" \
             "lrd-boot_${ver}.img" "lrd-boot_${ver}.img.sha256" "lrd-boot_${ver}.img.asc" \
             "lrd-update_${ver}.json" "lrd-update_${ver}.json.asc"; do
      [ -f "$STORE/updates/$f" ] && continue
      curl -fL --progress-bar "$LRD_UPDATE_URL/$f" -o "$STORE/updates/$f" || warn "missing $f"
    done
  fi
  say "verifying hashes"
  ( cd "$STORE/updates" && sha256sum -c "lrd-rootfs_${ver}.raw.sha256" && sha256sum -c "lrd-boot_${ver}.img.sha256" ) \
    || die "hash mismatch"
  echo "$ver" > "$STORE/updates/.staged-version"
  say "downloaded and verified $ver"
  ;;

stage)
  need_root; mount_store
  ver="$(cat "$STORE/updates/.staged-version" 2>/dev/null)" || die "nothing downloaded"
  slot="$(other_slot)"
  say "staging $ver to slot $slot (current: $(cur_slot))"
  # copy to the slot's file names so the initramfs can find them by slot
  cp -f "$STORE/updates/lrd-rootfs_${ver}.raw" "$STORE/lrd-rootfs_${slot}.raw.new"
  mv -f "$STORE/lrd-rootfs_${slot}.raw.new" "$STORE/lrd-rootfs_${slot}.raw"
  cp -f "$STORE/updates/lrd-boot_${ver}.img" "$STORE/lrd-boot_${slot}.img"
  echo "$ver" > "$STORE/lrd-version_${slot}"
  sync
  mkdir -p "$STORE/verity"
  cp -f "$STORE/updates/lrd-verity_${slot}.json"* "$STORE/verity/" 2>/dev/null || true
  if [ -f "$STORE/verity/lrd-verity_${slot}.json" ] && [ -f /etc/lrd/keys/verity.pub.pem ]; then
    say "verifying the update's crypto and verity metadata"
    meta="$STORE/verity/lrd-verity_${slot}.json"
    openssl dgst -sha256 -verify /etc/lrd/keys/verity.pub.pem \
      -signature "$meta.sig" "$meta" || die "metadata signature INVALID"
    jq -e '.layout=="luks2+verity-inside" and .rootHash and .dataBlocks' "$meta" >/dev/null \
      || die "metadata is not a crypto layout — refusing to arm"
    mkdir -p "$STORE/keys"
    lrd-crypt header-backup "$STORE/lrd-rootfs_${slot}.raw" "$STORE/keys/luks_header_${slot}.img" 2>/dev/null || true
  fi
  say "staged. run 'lrd-update apply' to arm and reboot"
  ;;

apply)
  need_root
  slot="$(other_slot)"
  say "arming slot $slot with 6 tries — the bootloader reverts if it never boots"
  $BC --arm "$slot" 6
  # bind the new index into the cmdline of the new boot image, then advance the counter
  NEWIDX="$(jq -r '.rollbackIndex // 1' "$STORE/verity/lrd-verity_${slot}.json" 2>/dev/null || echo 1)"
  "$STORE/../usr/bin/lrd-rollback" seal 2>/dev/null || lrd-rollback seal 2>/dev/null || true
  lrd-rollback advance "$NEWIDX" 2>/dev/null || true
  # remember the rollback point so the UI can offer it
  jq -nc --arg from "$(cat /etc/os-release | sed -n 's/^VERSION_ID="\(.*\)"/\1/p')" --arg to "$(cat "$STORE/lrd-version_${slot}" 2>/dev/null || echo unknown)" \
     --arg slot "$slot" --arg at "$(date -Is)" '{from:$from,to:$to,slot:$slot,at:$at}' > /var/lib/lrd/update.pending
  sync
  say "rebooting into $slot"
  systemctl reboot
  ;;

rollback)
  need_root
  slot="$(other_slot)"
  say "forcing a rollback to slot $slot"
  $BC --arm "$slot" 1        # 1 try: boot it once, countdown returns us if it is also bad
  sync; systemctl reboot
  ;;

status)
  mount_store 2>/dev/null || true
  echo "running:  slot $(cur_slot)  $(sed -n 's/^VERSION_ID="\(.*\)"/\1/p' /etc/os-release)"
  echo "other:    slot $(other_slot)  $(cat "$STORE/lrd-version_$(other_slot)" 2>/dev/null || echo 'nothing staged')"
  echo
  /usr/sbin/lrd-bootcount --status 2>/dev/null || echo "(bootloader control unavailable)"
  [ -f /var/lib/lrd/update.pending ] && { echo; echo "pending:"; jq . /var/lib/lrd/update.pending; }
  ;;

confirm)
  # called by the user after verifying the new boot; clears the pending marker
  rm -f /var/lib/lrd/update.pending
  /usr/sbin/lrd-bootcount --mark-success
  say "confirmed on $(cur_slot)"
  ;;

*) echo "usage: lrd-update {check|download|stage|apply|rollback|status|confirm}"; exit 2 ;;
esac
