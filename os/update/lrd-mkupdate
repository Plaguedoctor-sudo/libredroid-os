#!/usr/bin/env bash
# lrd-mkupdate — package a rootfs + boot image into a signed update set.
set -Eeuo pipefail
ROOTFS="${1:?rootfs.img}"; BOOT="${2:?boot.img}"
VER="${LRD_VERSION:?set LRD_VERSION}"
OUT="${OUT:-$PWD/update}"
KEY="${LRD_SIGN_KEY:?set LRD_SIGN_KEY (gpg key id)}"
command -v systemd-sysupdate >/dev/null || echo "note: systemd-sysupdate not on this host (fine for building)"

mkdir -p "$OUT"; cd "$OUT"
say(){ printf '\033[1;36m::\033[0m %s\n' "$*"; }

say "verity metadata"
[ -f "$ROOTFS.verity/lrd-verity_${LRD_SLOT:-a}.json" ] || [ -d "$(dirname "$ROOTFS")/verity" ] \
  || die "no verity metadata alongside the rootfs — an update without it fails under policy=strict"
cp -a "$(dirname "$ROOTFS")/verity/." "$OUT/" 2>/dev/null || true

say "hashing"
cp "$ROOTFS" "lrd-rootfs_${VER}.raw"
cp "$BOOT"   "lrd-boot_${VER}.img"
sha256sum "lrd-rootfs_${VER}.raw" > "lrd-rootfs_${VER}.raw.sha256"
sha256sum "lrd-boot_${VER}.img"   > "lrd-boot_${VER}.img.sha256"

say "signing"
for f in "lrd-rootfs_${VER}.raw" "lrd-boot_${VER}.img"; do
  gpg --batch --yes --armor --detach-sign --local-user "$KEY" "$f"
done

say "manifest"
cat > "lrd-update_${VER}.json" <<EOF
{
  "version": "$VER",
  "builtAt": "$(date -Is)",
  "git": "$(git -C "${LRD_SRC:-.}" rev-parse HEAD 2>/dev/null || echo unknown)",
  "kernel": "$(uname -r)",
  "adapt": "${LRD_ADAPT:-unknown}",
  "artifacts": {
    "lrd-rootfs_${VER}.raw": "$(sha256sum "lrd-rootfs_${VER}.raw" | cut -d' ' -f1)",
    "lrd-boot_${VER}.img":   "$(sha256sum "lrd-boot_${VER}.img" | cut -d' ' -f1)"
  },
  "notes": "$(cat "${LRD_NOTES:-/dev/null}" 2>/dev/null | head -40 || echo)"
}
EOF
gpg --batch --yes --armor --detach-sign --local-user "$KEY" "lrd-update_${VER}.json"

say "index"
{
  echo "version=$VER"
  echo "built=$(date -Is)"
  echo "rootfs_sha=$(cut -d' ' -f1 < "lrd-rootfs_${VER}.raw.sha256")"
  echo "boot_sha=$(cut -d' ' -f1 < "lrd-boot_${VER}.img.sha256")"
} > index.txt
gpg --batch --yes --armor --detach-sign --local-user "$KEY" index.txt

say "done: $OUT"
ls -la "$OUT"
