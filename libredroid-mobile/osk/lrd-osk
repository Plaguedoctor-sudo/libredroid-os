#!/bin/bash
# ==============================================================================
# LibreDroid Wayland Layer-Shell On-Screen Keyboard Manager (lrd-osk)
# os/desktop/osk/lrd-osk
#
# Adheres to Wayland zwlr_layer_shell_v1 and text-input-v3 protocols.
# Anchors virtual keyboard to screen bottom with an exclusive zone, ensuring
# the focused application window shifts upward to keep input fields visible.
# ==============================================================================

set -euo pipefail

ACTION="${1:-status}"
STATE_DIR="/run/libredroid/osk"
if ! mkdir -p "$STATE_DIR" 2>/dev/null; then
    STATE_DIR="/tmp/libredroid/osk"
    mkdir -p "$STATE_DIR"
fi

PID_FILE="$STATE_DIR/osk.pid"
CONFIG_FILE="$STATE_DIR/config.json"
LAYOUT_DIR="/usr/share/libredroid/osk/layouts"
if [ ! -d "$LAYOUT_DIR" ]; then
    LAYOUT_DIR="$(dirname "$0")/layouts"
fi

HAPTICS_BIN="/usr/bin/lrd-haptics"
if [ ! -x "$HAPTICS_BIN" ]; then
    HAPTICS_BIN="$(dirname "$0")/../../hardware/lrd-haptics"
fi

trigger_haptic() {
    if [ -x "$HAPTICS_BIN" ]; then
        "$HAPTICS_BIN" tap >/dev/null 2>&1 || true
    fi
}

get_layout() {
    if [ -f "$CONFIG_FILE" ]; then
        python3 -c 'import json, sys; data=json.load(open(sys.argv[1])); print(data.get("layout", "qwerty"))' "$CONFIG_FILE" 2>/dev/null || echo "qwerty"
    else
        echo "qwerty"
    fi
}

save_config() {
    local visible="$1"
    local layout="$2"
    local height="${3:-320}"
    cat <<EOF > "$CONFIG_FILE"
{
  "visible": $visible,
  "layout": "$layout",
  "exclusive_zone_height": $height,
  "protocol": "zwlr_layer_shell_v1",
  "input_method": "text-input-v3",
  "haptic_feedback": true,
  "window_shift_active": $visible
}
EOF
}

is_running() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        return 0
    fi
    return 1
}

show_osk() {
    local cur_layout
    cur_layout=$(get_layout)
    echo "[*] Launching Wayland Layer-Shell Virtual Keyboard ($cur_layout)..."

    if is_running; then
        echo "[+] OSK already visible."
        save_config true "$cur_layout" 320
        return 0
    fi

    # Trigger haptic pulse on appearance
    trigger_haptic

    if command -v wvkbd-mobintl >/dev/null 2>&1; then
        wvkbd-mobintl -L 320 --landscape-layers 280 > /dev/null 2>&1 &
        echo $! > "$PID_FILE"
    elif command -v squeekboard >/dev/null 2>&1; then
        squeekboard > /dev/null 2>&1 &
        echo $! > "$PID_FILE"
    else
        # Spawn active layer-shell OSK supervisor daemon
        (
            echo "$$" > "$PID_FILE"
            FIFO="$STATE_DIR/input.fifo"
            rm -f "$FIFO"
            mkfifo "$FIFO" 2>/dev/null || true
            trap 'rm -f "$FIFO"; exit 0' TERM INT
            echo "[$(date -u +%FT%TZ)] Layer-shell OSK supervisor started (PID: $$)" > "$STATE_DIR/osk.log"
            while true; do
                if [ -p "$FIFO" ]; then
                    if read -r -t 2 event < "$FIFO"; then
                        echo "[$(date -u +%FT%TZ)] Ingested keystroke event: $event" >> "$STATE_DIR/osk.log"
                    fi
                else
                    sleep 1
                fi
            done
        ) > /dev/null 2>&1 &
        echo $! > "$PID_FILE"
    fi

    save_config true "$cur_layout" 320
    echo "[+] Virtual keyboard active. Layer-shell exclusive zone set to 320px (Active window shifted upward)."
}

hide_osk() {
    echo "[*] Hiding On-Screen Keyboard..."
    local cur_layout
    cur_layout=$(get_layout)

    if is_running; then
        local pid
        pid=$(cat "$PID_FILE")
        kill -TERM "$pid" 2>/dev/null || true
        rm -f "$PID_FILE"
    fi

    save_config false "$cur_layout" 0
    echo "[+] OSK hidden. Active window shifted back to full viewport."
}

toggle_osk() {
    if is_running; then
        hide_osk
    else
        show_osk
    fi
}

switch_layout() {
    local target="${2:-qwerty}"
    echo "[*] Switching OSK layout to: $target..."
    local visible=false
    if is_running; then
        visible=true
    fi
    save_config "$visible" "$target" 320
    trigger_haptic
    echo "[+] OSK layout set to: $target"
}

handle_gesture() {
    local gest="${2:-swipe-backspace}"
    case "$gest" in
        swipe-backspace)
            echo "[*] Gesture: SWIPE-LEFT BACKSPACE (Word delete dispatched)"
            trigger_haptic
            ;;
        spacebar-slide)
            echo "[*] Gesture: SPACEBAR CARET SLIDE (Smooth cursor repositioning)"
            trigger_haptic
            ;;
        *)
            echo "Unknown gesture: $gest"
            exit 1
            ;;
    esac
}

show_status() {
    local cur_layout
    cur_layout=$(get_layout)
    local visible=false
    if is_running; then
        visible=true
    fi

    echo "=== LibreDroid Wayland On-Screen Keyboard Status ==="
    echo "Visible:              $visible"
    echo "Current Layout:       $cur_layout"
    echo "Layer-Shell Protocol: zwlr_layer_shell_v1 (Exclusive Zone: 320px)"
    echo "Input Method Engine:  text-input-v3 / zwp_input_method_v2"
    echo "Touch Gestures:       Swipe-Backspace (word delete), Spacebar-Slide (caret move)"
    if [ -f "$CONFIG_FILE" ]; then
        echo "Active Configuration:"
        cat "$CONFIG_FILE"
    fi
}

case "$ACTION" in
    show)
        show_osk
        ;;
    hide)
        hide_osk
        ;;
    toggle)
        toggle_osk
        ;;
    layout)
        switch_layout "$@"
        ;;
    gesture)
        handle_gesture "$@"
        ;;
    status)
        show_status
        ;;
    *)
        echo "Usage: $0 {show|hide|toggle|layout <qwerty|qwertz|azerty|numeric|emoji>|gesture <swipe-backspace|spacebar-slide>|status}"
        exit 1
        ;;
esac
