# SPDX-License-Identifier: GPL-3.0-or-later
# SAP Sovereign OS — ARM64 Hardened Kernel Configuration (KSPP Baseline)

# Architecture & Security Features
CONFIG_ARM64=y
CONFIG_ARM64_PAN=y
CONFIG_ARM64_UAO=y
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
CONFIG_ARM64_BTI=y
CONFIG_ARM64_BTI_KERNEL=y
CONFIG_SHADOW_CALL_STACK=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y

# Stack & Memory Hardening
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y

# LSM, Sandboxing & Namespaces
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y

# Storage Integrity & dm-verity
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y

# Target ARM64 SoCs: RK3399 (PinePhone Pro), i.MX8MQ (MNT Reform), BCM2712 (RPi5)
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ARCH_MXC=y
CONFIG_ARCH_BCM2835=y

# GPUs & Display
CONFIG_DRM=y
CONFIG_DRM_PANFROST=m
CONFIG_DRM_ETNAVIV=m
CONFIG_DRM_V3D=m
CONFIG_DRM_VC4=m

# Cellular Modem & Audio
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_SND_SOC_ROCKCHIP=m
CONFIG_SND_SOC_ES8316=m
CONFIG_SND_SOC_WM8960=m
