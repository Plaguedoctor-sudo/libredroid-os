[Unit]
Description=LibreDroid Profile Application Service
Documentation=https://github.com/libredroid/libredroid
DefaultDependencies=no
After=systemd-remount-fs.service
Before=phoc.service display-manager.service user@.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/lrd-profile-apply /usr/share/profiles /run/libredroid
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target
