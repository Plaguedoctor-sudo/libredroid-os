#!/usr/bin/env python3
"""
LibreDroid Profile Build-Time Compiler
Spec compliance: LibreDroid System Design v0.1 §2, §3
Compiles TOML profiles into minimal flat key=value .env files for the rootfs
so that early userspace and systemd can parse them without Python.
"""

import sys
from pathlib import Path

try:
    import tomllib
except ImportError:
    try:
        import tomli as tomllib
    except ImportError:
        sys.exit("Error: Python tomllib or tomli required for profile compilation.")

def compile_profile(toml_path: Path, out_path: Path):
    data = tomllib.loads(toml_path.read_text(encoding="utf-8"))
    
    dev = data.get("device", {})
    disp = data.get("display", {})
    android = data.get("android", {})
    hybris = data.get("hybris", {})
    shell = data.get("shell", {})
    waydroid = data.get("waydroid", {})
    egress = data.get("egress", {})

    codename = dev.get("codename", toml_path.stem)
    scale = float(disp.get("scale", 1.0))
    gdk_scale = max(1, int(round(scale)))
    gdk_dpi_scale = round(scale / gdk_scale, 2)
    ff_scale = float(shell.get("firefox_touch_scale", -1.0))

    lines = [
        f"# LibreDroid Precompiled Profile: {codename}",
        f"LRD_DEVICE_CODENAME=\"{codename}\"",
        f"LRD_DEVICE_MODEL=\"{dev.get('model', codename)}\"",
        f"LRD_DEVICE_MANUFACTURER=\"{dev.get('manufacturer', 'unknown')}\"",
        f"LRD_FORM_FACTOR=\"{dev.get('form_factor', 'phone')}\"",
        f"LRD_SOC=\"{dev.get('soc', 'unknown')}\"",
        f"LRD_SCALE=\"{scale}\"",
        f"LRD_PRIMARY_OUTPUT=\"{disp.get('primary_output', 'DSI-1')}\"",
        f"LRD_TRANSFORM=\"{disp.get('transform', 'normal')}\"",
        f"LRD_VNDK=\"{android.get('target_vndk', 31)}\"",
        f"LRD_HALIUM=\"{android.get('halium_version', 12)}\"",
        f"LRD_COMPOSITOR=\"{shell.get('compositor', 'phoc-hybris')}\"",
        f"LRD_SESSION_UI=\"{shell.get('session_ui', 'phosh')}\"",
        f"LRD_FF_SCALE=\"{ff_scale}\"",
        f"GDK_SCALE=\"{gdk_scale}\"",
        f"GDK_DPI_SCALE=\"{gdk_dpi_scale}\"",
        f"QT_SCALE_FACTOR=\"{scale}\"",
        f"WLR_LIBINPUT_NO_CONFIG=\"1\"",
        f"HYBRIS_LD_LIBRARY_PATH=\"/usr/lib/libhybris/arm64-v8a/vndk-{android.get('target_vndk', 31)}\"",
        f"LRD_WAYDROID_ENABLE=\"{str(waydroid.get('enable', True)).lower()}\"",
        f"LRD_EGRESS_MODE=\"{egress.get('default_mode', 'tunnel_only')}\"",
        f"LRD_KILLSWITCH=\"{str(egress.get('kill_switch', True)).lower()}\"",
    ]

    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"✔ Compiled {toml_path.name} -> {out_path.name}")

def main():
    if len(sys.argv) < 3:
        print("Usage: lrd-profile-compiler <input.toml> <output.env>")
        sys.exit(1)
    compile_profile(Path(sys.argv[1]), Path(sys.argv[2]))

if __name__ == "__main__":
    main()
